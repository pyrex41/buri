(* Test vectors for Buri.Lib against Rocq's Z semantics. Expected values are computed by Python,
   whose // and bitwise operators agree with Z.div and Z.land/lor/lxor/shiftr on unbounded integers. *)
module Buri.LibTest
open Buri.Lib
#push-options "--fuel 0 --ifuel 0"
let _ = assert_norm (zquot (7) (2) == (3))
let _ = assert_norm (zrem (7) (2) == (1))
let _ = assert_norm (zdiv (7) (2) == (3))
