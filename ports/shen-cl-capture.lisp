;;; Trusted native conformance harness, never an untrusted artifact checker.
;;; Reads the pinned port source with reader evaluation disabled. It evaluates
;;; only the two selected DEFUNs, retaining the original forms for capture.
(defpackage :shen (:use :cl))
(in-package :cl-user)
(defun coq-string (s stream)
  (write-char #\" stream)
  (loop for c across s do (write-char c stream) (when (char= c #\") (write-char c stream)))
  (write-char #\" stream))
(defun capture-coq (x stream)
  (cond ((null x) (write-string "Nil" stream))
        ((symbolp x) (write-string "(Sym " stream)
         (coq-string (concatenate 'string (package-name (symbol-package x)) ":" (symbol-name x)) stream)
         (write-char #\) stream))
        ((stringp x) (write-string "(Text " stream) (coq-string x stream) (write-char #\) stream))
        ((consp x) (write-string "(Pair " stream) (capture-coq (car x) stream)
         (write-char #\Space stream) (capture-coq (cdr x) stream) (write-char #\) stream))
        (t (error "Unsupported source datum: ~S" x))))
(defun capture-shen (x stream)
  (cond ((null x) (write-string "nil" stream))
        ((symbolp x) (write-string "(symbol " stream)
         (prin1 (concatenate 'string (package-name (symbol-package x)) ":" (symbol-name x)) stream)
         (write-char #\) stream))
        ((stringp x) (write-string "(text " stream) (prin1 x stream) (write-char #\) stream))
        ((consp x) (write-string "(pair " stream) (capture-shen (car x) stream)
         (write-char #\Space stream) (capture-shen (cdr x) stream) (write-char #\) stream))
        (t (error "Unsupported source datum: ~S" x))))
(let* ((args (cdr sb-ext:*posix-argv*))
       (source (first args)) (output (second args)) (mode (third args))
       (guard-name (find-symbol "shen-cl.true?" :shen))
       (forms nil))
  ;; INTERN before reading ensures the symbol lookup is not NIL.
  (setf guard-name (intern "shen-cl.true?" :shen))
  (let ((*package* (find-package :shen)) (*read-eval* nil) (*readtable* (copy-readtable nil)))
    ;; Preserve read-time evaluation as inert syntax in unrelated definitions.
    ;; It can never match the admitted guard and is never executed.
    (set-dispatch-macro-character #\# #\.
      (lambda (stream subchar arg) (declare (ignore subchar arg))
        (list :disabled-reader-eval (read stream t nil t))))
    (with-open-file (in source)
      (loop for form = (read in nil :eof) until (eq form :eof) do
        (when (and (consp form) (eq (car form) 'defun)
                   (member (second form) (list guard-name (intern "simple-error" :shen))))
          (push form forms)))))
  (let ((guards (remove-if-not (lambda (x) (eq (second x) guard-name)) forms)))
    (assert (= (length guards) 1))
    (let ((guard (copy-tree (first guards))))
      (cond ((equal mode "swap")
             (setf guard (subst (intern "false" :shen) (intern "true" :shen) guard)))
            ((equal mode "host-truthiness")
             (setf (fourth guard) (list 'if (intern "X" :shen) t nil)))
            ((equal mode "changed-message")
             (setf guard (subst "changed diagnostic" "boolean expected: not ~A~%" guard :test #'equal))))
      (with-open-file (out output :direction :output :if-exists :supersede)
        (write-line "From Coq Require Import String." out)
        (write-line "From Buri Require Import CLPortGuard." out)
        (write-line "Import CLPortGuard.CLPortGuard." out)
        (write-line "Open Scope string_scope." out)
        (write-string "Definition captured_guard : sexp := " out)
        (capture-coq guard out) (write-line "." out)
        (write-line "Theorem captured_guard_admitted : admitted captured_guard = true." out)
        (write-line "Proof. vm_compute. reflexivity. Qed." out)
        (write-line "Theorem captured_guard_correct : forall x, run captured_guard x = strict_guard x." out)
        (write-line "Proof. intros. apply actual_guard_refinement. exact captured_guard_admitted. Qed." out))
      (unless mode
        (with-open-file (out (make-pathname :type "sexp" :defaults output) :direction :output :if-exists :supersede)
          (capture-shen guard out) (terpri out))
        (dolist (form (reverse forms)) (eval form))
        (let ((true (intern "true" :shen)) (false (intern "false" :shen)))
          (assert (eq (funcall guard-name true) t))
          (assert (null (funcall guard-name false)))
          (dolist (x (list nil t 0 1 -1 1/2 1.0 "true" :true (list true) #() #'identity))
            (assert (eq :raised (handler-case (progn (funcall guard-name x) :returned)
                                  (error () :raised)))))
          ;; Distinct symbols in another package are not Shen booleans.
          (assert (eq :raised (handler-case (funcall guard-name (intern "true" :cl-user))
                                (error () :raised))))
          (dolist (v (list true false 0))
            (let ((events nil))
              (handler-case
                  (if (funcall guard-name (progn (push :test events) v))
                      (push :then events) (push :else events))
                (error () (push :error events)))
              (assert (equal (reverse events)
                             (list :test (cond ((eq v true) :then) ((eq v false) :else) (t :error))))))))
        (format t "CL guard: native samples and branch-order tests passed.~%")))))
