;; Sampled (emulated) readings of object words in a running Chez Scheme
;; 10.3.0 tarm64le process.  Output lines: NAME VALUE (decimal).  Offsets are
;; relative to the tagged pointer, as in generated code (#%$object-ref).
;; Evidence kind: emulated run (qemu-user), a ground sample of one process.
;; It is NOT the source of any constant; ChezLayout.v takes constants from
;; the pinned sources and Rocq compares this sample against them.
(define (show name v) (printf "~a ~d\n" name v))
(define p (cons 1 -2))
(define s (string #\a (integer->char #x3bb)))
(define v (vector #t #f '() (void) 5))
(define big (expt 2 70))
(define fl 1.5)
(show "machine-type-tarm64le" (if (eq? (machine-type) 'tarm64le) 1 0))
(show "fixnum-width" (fixnum-width))
(show "most-positive-fixnum" (most-positive-fixnum))
(show "most-negative-fixnum" (most-negative-fixnum))
(show "pair-car-word" (#%$object-ref 'uptr p 7))
(show "pair-cdr-word" (#%$object-ref 'uptr p 15))
(show "vector-header" (#%$object-ref 'uptr v 1))
(show "vector-elt0-true" (#%$object-ref 'uptr v 9))
(show "vector-elt1-false" (#%$object-ref 'uptr v 17))
(show "vector-elt2-nil" (#%$object-ref 'uptr v 25))
(show "vector-elt3-void" (#%$object-ref 'uptr v 33))
(show "vector-elt4-fixnum5" (#%$object-ref 'uptr v 41))
(show "string-header" (#%$object-ref 'uptr s 1))
(show "string-char0" (#%$object-ref 'unsigned-32 s 9))
(show "string-char1" (#%$object-ref 'unsigned-32 s 13))
(show "bignum-header" (#%$object-ref 'uptr big 1))
(show "bignum-bigit0" (#%$object-ref 'unsigned-32 big 9))
(show "bignum-bigit1" (#%$object-ref 'unsigned-32 big 13))
(show "bignum-bigit2" (#%$object-ref 'unsigned-32 big 17))
(show "flonum-bits" (#%$object-ref 'unsigned-64 fl 6))
(show "symbol-name-is-string" (if (string? (#%$object-ref 'scheme-object 'foo 29)) 1 0))
(define (f x) (lambda (y) (cons x y)))
(define clo (f 1))
(show "closure-code-is-code" (if (#%$code? (#%$closure-code clo)) 1 0))
(show "closure-entry-mod16" (modulo (#%$object-ref 'uptr clo 3) 16))
(show "closure-free0" (#%$object-ref 'uptr clo 11))
(show "pair-ptr-mod16" (modulo (#%$object-address p 0) 16))
(show "flonum-ptr-mod16" (modulo (#%$object-address fl 0) 16))
(show "symbol-ptr-mod16" (modulo (#%$object-address 'foo 0) 16))
(show "closure-ptr-mod16" (modulo (#%$object-address clo 0) 16))
(show "string-ptr-mod16" (modulo (#%$object-address s 0) 16))
(show "vector-ptr-mod16" (modulo (#%$object-address v 0) 16))
(show "bignum-ptr-mod16" (modulo (#%$object-address big 0) 16))
(show "closure-entry-minus-code" (- (#%$object-ref 'uptr clo 3) (#%$object-address (#%$closure-code clo) 0)))
