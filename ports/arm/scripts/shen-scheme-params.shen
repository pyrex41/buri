(set *maximum-print-sequence-size* 200)
(define buri-params
  _ -> [optimize-level ((foreign scm.optimize-level))
         debug-level ((foreign scm.debug-level))
         generate-inspector-information ((foreign scm.generate-inspector-information))
         generate-procedure-source-information ((foreign scm.generate-procedure-source-information))
         enable-type-recovery ((foreign scm.enable-type-recovery))
         generate-interrupt-trap ((foreign scm.generate-interrupt-trap))
         compile-interpret-simple ((foreign scm.compile-interpret-simple))
         enable-unsafe-application ((foreign scm.enable-unsafe-application))
         enable-unsafe-variable-reference ((foreign scm.enable-unsafe-variable-reference))
         enable-arithmetic-left-associative ((foreign scm.enable-arithmetic-left-associative))
         commonization-level ((foreign scm.commonization-level))
         enable-cross-library-optimization ((foreign scm.enable-cross-library-optimization))
         enable-error-source-expression ((foreign scm.enable-error-source-expression))
         generate-covin-files ((foreign scm.generate-covin-files))
         generate-profile-forms ((foreign scm.generate-profile-forms))
         compile-profile ((foreign scm.compile-profile))
         current-eval-is-compile ((foreign scm.eval) ((foreign scm.read) ((foreign scm.open-input-string) "(eq? (current-eval) compile)")))
         current-eval-is-interpret ((foreign scm.eval) ((foreign scm.read) ((foreign scm.open-input-string) "(eq? (current-eval) interpret)")))
         plus-is-chez-plus ((foreign scm.eval) ((foreign scm.read) ((foreign scm.open-input-string) "(eq? (eval '+ (interaction-environment)) (top-level-value '+ (scheme-environment)))")))
         threaded ((foreign scm.threaded?))
         machine ((foreign scm.machine-type))
         version ((foreign scm.scheme-version))])
(print (buri-params 0))
(nl)
