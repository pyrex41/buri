[schema addition inputs [x y] source [+ x y] emitted [+ x y]]
[schema subtraction inputs [x y] source [- x y] emitted [- x y]]
[schema multiplication inputs [x y] source [* x y] emitted [* x y]]
[schema nested inputs [x y z] source [+ [* x y] [- z 3]] emitted [let [[_scm.arg6021 [* x y]]] [+ _scm.arg6021 [- z 3]]]]
[schema let-binding inputs [x y] source [let a [+ x 1] [* a y]] emitted [let [[a [+ x 1]]] [* a y]]]
[schema shadowing inputs [x y] source [let x [+ x 1] [- x y]] emitted [let [[x [+ x 1]]] [- x y]]]
[schema nested-let inputs [x y] source [let a [+ x 1] [let b [* a y] [- b a]]] emitted [let* [[a [+ x 1]] [b [* a y]]] [- b a]]]
[schema shadowed-let inputs [x y] source [let x [+ x y] [let x [* x 2] [- x y]]] emitted [let* [[x [+ x y]] [x [* x 2]]] [- x y]]]
[schema left-right inputs [x y z] source [- [+ x y] [* y z]] emitted [let [[_scm.arg6022 [+ x y]]] [- _scm.arg6022 [* y z]]]]
[schema negative inputs [x] source [+ x -17] emitted [+ x -17]]
[schema large inputs [x] source [+ x 9223372036854775808] emitted [+ x 9223372036854775808]]
[schema unused-binding inputs [x y] source [let unused [* x y] [+ x y]] emitted [let [[unused [* x y]]] [+ x y]]]
