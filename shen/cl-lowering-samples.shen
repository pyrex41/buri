\\ Sampled agreement between the actual Shen-CL lowering and the Rocq
\\ interpretation of its admitted source. Opt-in native harness only: the
\\ caller must first load shen/cl-lowering-capture.shen and the pinned
\\ Shen-CL src/compiler.shen into this Shen host. This file executes that
\\ port code on the samples below and records inputs and outputs as inert
\\ Rocq data; Rocq decides agreement. It is evidence of sampled agreement,
\\ never a universal theorem, and the host here is not SBCL.

\\ Shen data to Rocq sv. The Shen host has no CL packages: (cl nil) yields the
\\ symbol NIL, which the CL reader identifies with (). That identification is
\\ the documented CL symbol-identity contract, applied here explicitly.
(define buri.cll-sv
  [] -> "VNil"
  X -> "VNil" where (= X (intern "NIL"))
  [X | Y] -> (cn "(VCons " (cn (buri.cll-sv X) (cn " " (cn (buri.cll-sv Y) ")"))))
  X -> (cn "(VSym " (cn (buri.cll-coq-string (str X)) ")")) where (boolean? X)
  X -> (cn "(VSym " (cn (buri.cll-coq-string (str X)) ")")) where (symbol? X)
  X -> (cn "(VStr " (cn (buri.cll-coq-string X) ")")) where (string? X)
  X -> (cn "(VNum " (cn (buri.cll-coq-string (str X)) ")")) where (number? X)
  _ -> (simple-error "unsupported sample datum"))

\\ KLambda conditionals with their lexical scope. Lower-case variable names keep
\\ the samples free of Shen variables; compile-expression only consults Scope.
(define buri.cll-if-samples ->
  [[[if x a b] [x]]
   [[if true a b] []]
   [[if false a b] []]
   [[if [cons? x] a b] [x]]
   [[if [and [cons? x] [= x 1]] a [not [string? y]]] [x y]]
   [[if [or [number? x] [empty? x]] [hd x] [tl x]] [x]]
   [[if [not [= x "s"]] a b] [x]]
   [[if [= x a] b c] [x]]
   [[if [= x []] a b] [x]]
   [[if [> x 1] a b] [x]]
   [[if [<= x 1] a b] [x]]
   [[if [let y [f x] [<= y 2]] a b] [x]]
   [[if [do [print x] [boolean? x]] a b] [x]]
   [[if [if x [cons? y] false] a b] [x y]]
   [[if [= 1 x] a b] [x]]
   [[if [shen-cl.equal? x 1] a b] [x]]
   [[if [shen-cl.equal? 1 x] a b] [x]]
   [[if [shen-cl.equal? "s" x] a b] [x]]
   [[if [shen-cl.equal? x "s"] a b] [x]]
   [[if [shen-cl.equal? x [fail]] a b] [x]]
   [[if [shen-cl.equal? [fail] x] a b] [x]]
   [[if [shen-cl.equal? x []] a b] [x]]
   [[if [shen-cl.equal? [] x] a b] [x]]
   [[if [shen-cl.equal? x sym] a b] [x]]
   [[if [shen-cl.equal? sym x] a b] [x]]
   [[if [shen-cl.equal? x y] a b] [x y]]
   [[if [shen-cl.greater-than-or-equal-to? x 1] a b] [x]]
   [[if [shen-cl.less? x 1] a b] [x]]
   [[if [f x] [g x] [h x]] [x]]])

\\ Already-lowered CL forms given directly to optimise-boolean-check.
(define buri.cll-opt-samples ->
  [[(intern "QUOTE") true] [(intern "QUOTE") false] [(intern "QUOTE") other]
   [(intern "PROGN") a [b x]] [(intern "LET*") [[x 1]] [f x]]])

(define buri.cll-ce-entry Kl Scope ->
  (make-string " if sv_eqb x ~A then LOk ~A else~A" (buri.cll-sv Kl)
    (buri.cll-sv (shen-cl.compile-expression Kl Scope)) (buri.cll-nl)))
(define buri.cll-cat [] -> "" [S | Ss] -> (cn S (buri.cll-cat Ss)))
(define buri.cll-if-sample N [[if C A B] Scope] ->
  (buri.cll-cat
   ["Definition ce_" (str N) " (x _ : sv) : lres :=" (buri.cll-nl)
    (buri.cll-ce-entry C Scope) (buri.cll-ce-entry A Scope) (buri.cll-ce-entry B Scope)
    " LUnsupported." (buri.cll-nl)
    "Example if_sample_" (str N) " : run 64 (lowering_defs captured_lowering) ce_" (str N) " EMIT_IF" (buri.cll-nl)
    " [" (buri.cll-sv C) "; " (buri.cll-sv A) "; " (buri.cll-sv B) "; " (buri.cll-sv Scope) "] = LOk "
    (buri.cll-sv (shen-cl.compile-expression [if C A B] Scope)) "." (buri.cll-nl)
    "Proof. vm_compute. reflexivity. Qed." (buri.cll-nl)]))
(define buri.cll-opt-sample N X ->
  (buri.cll-cat
   ["Example opt_sample_" (str N) " : run 64 (lowering_defs captured_lowering) (fun _ _ => LUnsupported) OPT" (buri.cll-nl)
    " [" (buri.cll-sv X) "] = LOk " (buri.cll-sv (shen-cl.optimise-boolean-check X)) "." (buri.cll-nl)
    "Proof. vm_compute. reflexivity. Qed." (buri.cll-nl)]))
(define buri.cll-each F N [] -> ""
  F N [X | Xs] -> (cn (F N X) (buri.cll-each F (+ N 1) Xs)))

(define buri.cll-samples Out ->
  (do (write-to-file Out
       (cn (buri.cll-lines
            ["(* Generated by shen/cl-lowering-samples.shen: SAMPLED agreement only."
             "   Outputs were produced by executing Shen-CL 4844072 src/compiler.shen on the"
             "   Shen host used by Buri (not SBCL); Rocq checks that interpreting the admitted"
             "   capture yields the same data. Not a universal theorem. *)"
             "From Coq Require Import String List."
             "Import ListNotations."
             "From Buri Require Import CLLowering CLLoweringCapture."
             "Open Scope string_scope."])
       (cn (buri.cll-each (/. N X (buri.cll-if-sample N X)) 1 (buri.cll-if-samples))
           (buri.cll-each (/. N X (buri.cll-opt-sample N X)) 1 (buri.cll-opt-samples)))))
      sampled))
