\\ Port-fix lane: inert capture of the PATCHED Shen-CL lowering definitions.
\\ Load after shen/cl-lowering-capture.shen; it reuses that file's byte lexer,
\\ parser, selector and Rocq renderer and decides nothing. Rocq admits the
\\ emitted ASTs against reviewed expected ASTs (rocq/CLLoweringPatch.v).
\\ Stock is the vendored ports/upstream/shen-cl/compiler.shen; Patched is the
\\ same file with ports/patches/shen-cl-compiler.diff applied by
\\ scripts/package-patched.py (both blobs are checked there, not here).

(define buri.cllp-wanted -> ["optimise-boolean-check" "optimise-boolean-sequence" "emit-cond" "emit-cond-clauses"])
(define buri.cllp-names -> ["patched_optimise" "patched_sequence" "patched_emit_cond" "patched_emit_cond_clauses"])

(define buri.cllp-forms Source -> (buri.cll-parse-all (buri.cll-lex (read-file-as-bytelist Source))))

(define buri.cllp-capture Stock Patched StockBlob PatchedBlob Out ->
  (let SPkg (buri.cll-package (buri.cllp-forms Stock))
       PPkg (buri.cll-package (buri.cllp-forms Patched))
       Header [paren [[sym "package"] (hd PPkg) (hd (tl PPkg))]]
       Spanned (map (/. N (buri.cll-select (hd (tl (tl PPkg))) N)) (buri.cllp-wanted))
       Defs (map (/. D (buri.cll-strip D)) Spanned)
       StockSpanned (buri.cll-select (hd (tl (tl SPkg))) "emit-cond-clauses")
       StockCond (buri.cll-strip StockSpanned)
       Sys (buri.cll-sysfuncs Defs)
       Text (cn (make-string "(* Generated by shen/cl-lowering-patch-capture.shen. Inert reader-level capture.~A   Stock: Shen-CL 4844072dde0208c3e4b99dcbfea58e4fdfd812e8 src/compiler.shen blob ~A~A   Patched: the same with ports/patches/shen-cl-compiler.diff applied, blob ~A *)~A"
                              (buri.cll-nl) StockBlob (buri.cll-nl) PatchedBlob (buri.cll-nl))
            (cn (buri.cll-spans (buri.cllp-wanted) Spanned)
            (cn (buri.cll-span-line "stock emit-cond-clauses" StockSpanned)
            (cn (make-string "From Coq Require Import String List.~AImport ListNotations.~AFrom Buri Require Import CLLowering CLLoweringPatch.~AOpen Scope string_scope.~A" (buri.cll-nl) (buri.cll-nl) (buri.cll-nl) (buri.cll-nl))
            (cn (buri.cll-def-line "patched_package" Header)
            (cn (buri.cll-defs (buri.cllp-names) Defs)
            (cn (buri.cll-def-line "stock_emit_cond_clauses" StockCond)
            (cn (make-string "Definition patched_sysfuncs : list string := ~A.~A" (buri.cll-coq-strings Sys) (buri.cll-nl))
                (buri.cllp-tail)))))))))
    (do (write-to-file Out Text) captured)))

(define buri.cllp-tail ->
  (buri.cll-lines
   ["Definition captured_patch : patch_source := mk_patch_source patched_package patched_optimise patched_sequence patched_emit_cond patched_emit_cond_clauses stock_emit_cond_clauses patched_sysfuncs."
    "Theorem captured_patch_admitted : admitted_patch captured_patch = true."
    "Proof. vm_compute. reflexivity. Qed."
    "Theorem captured_patch_optimise_sound : forall St prim other sym ce n v r,"
    " primitive_contracts St prim -> (forall v, sym v = true -> symbolic v = true) ->"
    " run_p sym n (fst (patch_defs captured_patch)) ce OPT [v] = LOk r -> OptEquiv St prim other v r."
    "Proof. intros. eapply admitted_patch_optimise_sound; eauto. exact captured_patch_admitted. Qed."
    "Theorem captured_patch_cond_final_t : forall sym ce n cs sc r,"
    " run_p sym n (fst (patch_defs captured_patch)) ce ECC [cs; sc] = LOk r ->"
    " exists pre fin, r = clauses_t pre fin /\ Forall pair_clause pre /\ (no_true_cl cs -> ce cl_err sc = LOk fin)."
    "Proof. intros. eapply admitted_patch_cond_final_t; eauto. exact captured_patch_admitted. Qed."]))
