(load "buri.shen")
(load "ports/compiler-merge.shen")
(load "tests/support.shen")
(buri.test merge-two (_scm.merge-nested-lets [let [[x a]] [let [[y b]] c]]) [let* [[x a] [y b]] c])
(buri.test merge-many (_scm.merge-nested-lets [let [[x a]] [let* [[y b] [z c]] d]]) [let* [[x a] [y b] [z c]] d])
(buri.test merge-empty (_scm.merge-nested-lets [let [[x a]] [let* [] b]]) [let* [[x a]] b])
(buri.test merge-atomic (_scm.merge-nested-lets alpha) alpha)
(buri.test merge-shadowing (_scm.merge-nested-lets [let [[x a]] [let [[x b]] x]]) [let* [[x a] [x b]] x])
(buri.done)
