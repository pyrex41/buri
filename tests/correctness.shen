(load "buri.shen")
(load "ports/compiler-order.shen")
(load "tests/support.shen")
(buri.test numeric-integral (/ 6 2) 3)
(buri.test numeric-negative-integral (/ -6 2) -3)
(buri.test numeric-positive-fraction (/ 1 2) 0.5)
(buri.test numeric-negative-fraction (/ -1 2) -0.5)
(buri.test numeric-negative-denominator (/ 1 -2) -0.5)
(buri.test numeric-large-floor-counterexample (floor (/ 9007199254740995 2)) 4503599627370498)
(buri.test numeric-exact-host-positive ((foreign scm.floor) ((foreign scm./) 9007199254740995 2)) 4503599627370497)
(buri.test numeric-exact-host-negative ((foreign scm.floor) ((foreign scm./) -9007199254740995 2)) -4503599627370498)
(buri.test numeric-zero-rejected (trap-error (/ 1 0) (/. E rejected)) rejected)
(buri.test simple-symbol (_scm.simple-scheme-expression? x) true)
(buri.test simple-number (_scm.simple-scheme-expression? 42) true)
(buri.test simple-quote (_scm.simple-scheme-expression? [quote [effect]]) true)
(buri.test simple-lambda (_scm.simple-scheme-expression? [lambda [x] [effect x]]) true)
(buri.test computation-call (_scm.simple-scheme-expression? [effect]) false)
(buri.test no-computation (_scm.has-computation? [x 42 [quote [effect]]]) false)
(buri.test has-computation (_scm.has-computation? [x [effect] 42]) true)
(buri.test order-simple (_scm.order-call [combine x 42]) [combine x 42])
(buri.test order-single-effect (_scm.order-call [combine [left]]) [combine [left]])
(buri.test fresh-collision
 (let Saved (value shen.*gensym*)
      First (gensym arg)
      Reset (set shen.*gensym* Saved)
      Fresh (_scm.fresh-call-variable [First])
   (= Fresh First)) false)
(define buri.order-shape [let [[Name [left]]] [combine Name [right]]] -> true _ -> false)
(buri.test order-two-shape (buri.order-shape (_scm.order-call [combine [left] [right]])) true)
(define buri.order-left -> (do (set buri.order-log (append (value buri.order-log) [left])) 1))
(define buri.order-right -> (do (set buri.order-log (append (value buri.order-log) [right])) 2))
(define buri.order-combine A B -> (+ (* 10 A) B))
(define buri.order-eval Target -> ((foreign scm.eval) Target))
(set buri.order-log [])
(buri.test native-ordered-result
 (buri.order-eval (_scm.order-call [(intern "kl:buri.order-combine") [(intern "kl:buri.order-left")] [(intern "kl:buri.order-right")]])) 12)
(buri.test native-ordered-effects (value buri.order-log) [left right])
(define buri.order-fail -> (do (set buri.order-log (append (value buri.order-log) [fail])) (simple-error "left failed")))
(set buri.order-log [])
(buri.test native-first-failure
 (trap-error (buri.order-eval (_scm.order-call [(intern "kl:buri.order-combine") [(intern "kl:buri.order-fail")] [(intern "kl:buri.order-right")]])) (/. E rejected)) rejected)
(buri.test native-failure-short-circuit (value buri.order-log) [fail])
(load "shen/observe-encoder.shen")
(set buri.observed [])
(buri.test pipeline-three
 (buri.observe-forms [[tc -] [define buri.pipeline-first -> 1] [define buri.pipeline-second -> 2] [define buri.pipeline-third -> 3]]) buri.pipeline-third)
(buri.test pipeline-record-count (length (value buri.observed)) 3)
(buri.test pipeline-first-live (buri.pipeline-first) 1)
(buri.test pipeline-third-live (buri.pipeline-third) 3)
(set buri.observed [])
(buri.test pipeline-second-rejected
 (trap-error (buri.observe-forms [[tc -] [define buri.pipeline-kept -> 7] [42] [define buri.pipeline-skipped -> 9]]) (/. E rejected)) rejected)
(buri.test pipeline-keeps-completed-record (length (value buri.observed)) 1)
(buri.test pipeline-keeps-live-definition (buri.pipeline-kept) 7)
(define buri.all-byte-text 256 -> ""
 N -> (cn (n->string N) (buri.all-byte-text (+ N 1))))
(do (set buri.byte-text (buri.all-byte-text 0)) true)
(buri.test bytes-count ((foreign scm.string-length) (value buri.byte-text)) 256)
(buri.test bytes-zero (string->n (pos (value buri.byte-text) 0)) 0)
(buri.test bytes-high (string->n (pos (value buri.byte-text) 255)) 255)
(do (write-to-file "_build/read-bytes.bin" (value buri.byte-text)) true)
(buri.test native-read-all-bytes (read-file-as-string "_build/read-bytes.bin") (value buri.byte-text))
(write-to-file "_build/read-empty.bin" "")
(buri.test native-read-empty (read-file-as-string "_build/read-empty.bin") "")
(buri.test native-read-error (trap-error (read-file-as-string "_build/buri-missing-input/no-file") (/. E rejected)) rejected)
(buri.test native-home-prefix
 (let Saved (value *home-directory*)
      Change (set *home-directory* "_build/")
      Actual (read-file-as-string "read-bytes.bin")
      Restore (set *home-directory* Saved)
  Actual) (value buri.byte-text))
(buri.test native-home-error
 (let Saved (value *home-directory*)
      Change (set *home-directory* "_build/")
      Actual (trap-error (read-file-as-string "buri-missing-input/no-file") (/. E rejected))
      Restore (set *home-directory* Saved)
  Actual) rejected)
(buri.done)
