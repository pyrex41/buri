(load "buri.shen")
(load "tests/support.shen")
(buri.test literal (buri.evaluate [] [literal [int 7]] 10) [returned [int 7]])
(buri.test closure (buri.evaluate [] [apply [lambda x [var x]] [literal [int 42]]] 30) [returned [int 42]])
(buri.test lexical (buri.evaluate []
 [let x [literal [int 10]]
  [let f [lambda y [primitive + [[var x] [var y]]]]
   [let x [literal [int 99]] [apply [var f] [literal [int 2]]]]]] 100) [returned [int 12]])
(buri.test shadowing (buri.evaluate [] [let x [literal [int 1]] [let x [literal [int 2]] [var x]]] 20) [returned [int 2]])
(buri.test branch-laziness (buri.evaluate [] [if [literal [bool true]] [literal [int 1]] [raise [literal [str "bad"]]]] 30) [returned [int 1]])
(buri.test branch-laziness-false (buri.evaluate [] [if [literal [bool false]] [raise [literal [str "bad"]]] [literal [int 2]]] 30) [returned [int 2]])
(buri.test invalid-condition (buri.evaluate [] [if [literal [int 0]] [literal [int 1]] [literal [int 2]]] 10) [raised "nonboolean-condition"])
(buri.test function-first (buri.evaluate [] [apply [raise [literal [str "function"]]] [raise [literal [str "argument"]]]] 20) [raised "function"])
(buri.test argument-before-call (buri.evaluate [] [apply [literal [int 4]] [raise [literal [str "argument"]]]] 20) [raised "argument"])
(buri.test arguments-left-first (buri.evaluate [] [primitive + [[raise [literal [str "left"]]] [raise [literal [str "right"]]]]] 20) [raised "left"])
(buri.test catch (buri.evaluate [] [trap [raise [literal [str "hello"]]] [lambda e [var e]]] 30) [returned [str "hello"]])
(buri.test handler-lazy (buri.evaluate [] [trap [literal [int 8]] [raise [literal [str "unused"]]]] 30) [returned [int 8]])
(buri.test handler-failure (buri.evaluate [] [trap [raise [literal [str "first"]]] [raise [literal [str "handler"]]]] 30) [raised "handler"])
(buri.test unbound (buri.evaluate [] [var absent] 10) [raised "unbound-variable"])
(buri.test nonfunction (buri.evaluate [] [apply [literal [int 1]] [literal [int 2]]] 20) [raised "not-callable"])
(buri.test freeze (buri.evaluate [] [let x [literal [int 10]] [let f [freeze [var x]] [let x [literal [int 99]] [thaw [var f]]]]] 100) [returned [int 10]])
(buri.test freeze-lazy (buri.evaluate [] [let x [freeze [raise [literal [str "unused"]]]] [literal [int 2]]] 20) [returned [int 2]])
(buri.test improper-cons (buri.evaluate [] [primitive tl [[primitive cons [[literal [int 1]] [literal [int 2]]]]]] 20) [returned [int 2]])
(buri.test bad-head (buri.evaluate [] [primitive hd [[literal nil]]] 20) [raised "primitive-domain-or-arity"])
(buri.test unsupported (buri.evaluate [] [primitive / [[literal [int 1]] [literal [int 2]]]] 20) [rejected unsupported-or-malformed-program])
(buri.test no-closure-literal (buri.evaluate [] [literal [closure x [var x] []]] 20) [rejected unsupported-or-malformed-program])
(buri.test no-eval (buri.evaluate [] [eval-kl [literal [int 1]]] 20) [rejected unsupported-or-malformed-program])
(buri.test no-mutation (buri.evaluate [] [set x [literal [int 1]]] 20) [rejected unsupported-or-malformed-program])
(buri.test bounded (buri.evaluate [] [literal [int 1]] 0) [unknown evaluation-budget])
(buri.test unknown-not-caught (buri.evaluate [] [trap [literal [int 1]] [lambda e [literal [int 2]]]] 1) [unknown evaluation-budget])
(define buri.factorial-defs ->
 [[fact [n] [if [primitive = [[var n] [literal [int 0]]]] [literal [int 1]]
   [primitive * [[var n] [apply [global fact] [primitive - [[var n] [literal [int 1]]]]]]]]]])
(buri.test recursion (buri.evaluate (buri.factorial-defs) [apply [global fact] [literal [int 6]]] 100) [returned [int 720]])
(buri.test divergence (buri.evaluate [[loop [x] [apply [global loop] [var x]]]] [apply [global loop] [literal [int 1]]] 30) [unknown evaluation-budget])
(buri.test partial-application (buri.evaluate [[sum [x y] [primitive + [[var x] [var y]]]]]
 [apply [apply [global sum] [literal [int 3]]] [literal [int 4]]] 30) [returned [int 7]])
(buri.test duplicate-globals (buri.evaluate [[f [x] [var x]] [f [y] [var y]]] [literal [int 1]] 10) [rejected unsupported-or-malformed-program])
(buri.test zero-arity-unsupported (buri.evaluate [[f [] [literal [int 1]]]] [global f] 10) [rejected unsupported-or-malformed-program])
(buri.test closure-equality (buri.evaluate [] [primitive = [[lambda x [var x]] [lambda x [var x]]]] 20) [unsupported closure-equality])
(buri.test replay (buri.replay [] [literal [int 2]] [returned [int 2]] 10)
 [accepted ground-replay [buri-kl-pure-1 [] [literal [int 2]] [returned [int 2]]]])
(buri.test replay-mismatch (buri.replay [] [literal [int 2]] [returned [int 3]] 10)
 [counterexample claimed [returned [int 3]] actual [returned [int 2]]])
(buri.test replay-budget (buri.replay [] [literal [int 2]] [returned [int 2]] 0) [unknown evaluation-budget])
(buri.test fractional-literal (buri.evaluate [] [literal [int 1.5]] 10) [rejected unsupported-or-malformed-program])
(buri.test reader-normalizes-integral-literal (buri.evaluate [] [literal [int 1.0]] 10) [returned [int 1]])
(buri.done)
