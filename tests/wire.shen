(load "buri.shen")
(load "shen/export-wire.shen")
(load "tests/support.shen")
(buri.test wire-nil (buri.wire []) "00")
(buri.test wire-pair (buri.wire [[] | []]) "10000")
(buri.test wire-zero (buri.wire 0) "0111000011000")
(buri.test wire-symbol (buri.wire x) "0101000111100")
(buri.test wire-byte-zero (buri.wire-byte 0 8) "00000000")
(buri.test wire-byte-one (buri.wire-byte 1 8) "10000000")
(buri.test wire-byte-255 (buri.wire-byte 255 8) "11111111")
(buri.test wire-type-distinction (= (buri.wire 1) (buri.wire x)) false)
(buri.test wire-refuses-float (trap-error (do (buri.wire 1.5) false) (/. E true)) true)
(buri.test wire-refuses-string (trap-error (do (buri.wire "x") false) (/. E true)) true)
(buri.done)
