(load "buri.shen")
(load "shen/export-encoder-kl.shen")
(load "shen/observe-encoder.shen")
(load "tests/support.shen")
\\ A forged source property must not influence the actual load capture.
(put buri.wire shen.source [defun buri.wire [X] "forged"])
(buri.observe-encoder "shen/wire.shen" "_build/test-observed.bits" "_build/test-observed.sexp")
(buri.test observed-installed-nil (buri.wire []) "00")
(buri.test observed-installed-pair (buri.wire [[] | []]) "10000")
(buri.test observed-installed-number (buri.wire 0) "0111000011000")
(buri.test observed-installed-byte (buri.wire-byte 255 8) "11111111")
(buri.test observed-installed-error (trap-error (do (buri.wire 1.5) false) (/. E true)) true)
(buri.test observed-complete-count (length (value buri.observed)) 3)
(buri.test observed-source-order
 (map (/. Record (hd (tl (hd Record)))) (reverse (value buri.observed)))
 [buri.wire-byte buri.wire-string buri.wire])
(buri.test observed-target-order
 (map (/. Record (hd (hd (tl (hd (tl Record)))))) (reverse (value buri.observed)))
 [(intern "kl:buri.wire-byte") (intern "kl:buri.wire-string") (intern "kl:buri.wire")])
(buri.test observed-ignores-metadata (= (hd (hd (value buri.observed))) (ps buri.wire)) false)
(buri.test observed-rejects-empty (trap-error (do (buri.observe-forms []) false) (/. E true)) true)
(buri.test observed-rejects-mode (trap-error (do (buri.observe-forms [[tc +] a b c]) false) (/. E true)) true)
(buri.test observed-rejects-nondefun (trap-error (do (buri.install-observed [set x 1]) false) (/. E true)) true)
(set buri.previous-records (value buri.observed))
(buri.test observed-compile-failure (trap-error (do (buri.install-observed [defun buri.bad-arguments "not-a-list" 0]) false) (/. E true)) true)
(buri.test observed-compile-failure-records (value buri.observed) (value buri.previous-records))
(set buri.bad-duplicate-target (_scm.kl->scheme [defun buri.bad-duplicate [X X] X]))
(buri.test observed-compiled-bad-target (hd (value buri.bad-duplicate-target)) define)
(buri.test observed-activation-failure (trap-error (do (buri.install-observed [defun buri.bad-duplicate [X X] X]) false) (/. E true)) true)
(buri.test observed-activation-failure-records (value buri.observed) (value buri.previous-records))
(buri.test observed-install-return (buri.install-observed [defun buri.observer-live [] 42]) buri.observer-live)
(buri.test observed-installed-result (eval-kl [buri.observer-live]) 42)
(buri.test observed-record-source (hd (hd (value buri.observed))) [defun buri.observer-live [] 42])
(buri.done)
