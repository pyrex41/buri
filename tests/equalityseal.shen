(load "buri.shen")
(load "shen/wire.shen")
(load "shen/observe-encoder.shen")
(load "shen/observe-constructor.shen")
(buri.observe-constructor "shen/equality-core.shen" "_build/equality-native.bits")
(load "shen/sealed-equality.shen")
(load "tests/support.shen")
(set buri.eq2-sealed (buri.make-sealed-eq2 (reverse (value buri.observed))))
(define buri.eq2-run Fn Proof -> (Fn Proof))
(buri.test sealed-refl (buri.eq2-run (value buri.eq2-sealed) [refl [var 0]]) [some [[var 0] [var 0]]])
(buri.test sealed-trans-mismatch (buri.eq2-run (value buri.eq2-sealed) [trans [refl [var 0]] [refl [var 1]]]) none)
(buri.test sealed-congruence (buri.eq2-run (value buri.eq2-sealed) [cong [refl [var 0]] [refl [const 1]]]) [some [[app [var 0] [const 1]] [app [var 0] [const 1]]]])
(buri.test sealed-no-rules (buri.eq2-run (value buri.eq2-sealed) [instance 0 []]) none)
(buri.test sealed-no-payload-execution (buri.eq2-run (value buri.eq2-sealed) [eval-kl [set buri.eq2-executed true]]) none)
(buri.test sealed-bad-record-count (trap-error (buri.make-sealed-eq2 []) (/. E rejected)) rejected)
(buri.test sealed-bad-definition (trap-error (buri.eq2-seal-definition bad) (/. E rejected)) rejected)
(define buri.eq2-limited-eval Program -> ((foreign scm.eval) (buri.eq2-seal-request Program)))
(buri.test sealed-no-native-eval-authority (trap-error (do (buri.eq2-limited-eval [lambda [x] [eval x]]) false) (/. E true)) true)
(buri.test sealed-no-mutation-authority (trap-error (do (buri.eq2-limited-eval [lambda [x] [set! x 0]]) false) (/. E true)) true)
(buri.test sealed-no-file-authority (trap-error (do (buri.eq2-limited-eval [lambda [x] [open-input-file x]]) false) (/. E true)) true)
(set buri.eq2-payload-executed false)
(buri.test sealed-inert-refl-payload
 (buri.eq2-run (value buri.eq2-sealed) [refl [eval-kl [set buri.eq2-payload-executed true]]])
 [some [[eval-kl [set buri.eq2-payload-executed true]] [eval-kl [set buri.eq2-payload-executed true]]]])
(buri.test sealed-payload-stays-inert (value buri.eq2-payload-executed) false)
(define buri.eq2-derive P -> [some [[var 0] [var 1]]])
(define buri.eq2-sym P -> [some [[var 0] [var 1]]])
(define buri.eq2-trans P Q -> [some [[var 0] [var 1]]])
(define buri.eq2-cong P Q -> [some [[var 0] [var 1]]])
(buri.test ambient-deriver-changed (buri.eq2-derive [refl [var 0]]) [some [[var 0] [var 1]]])
(buri.test sealed-refl-survives-rebinding (buri.eq2-run (value buri.eq2-sealed) [refl [var 0]]) [some [[var 0] [var 0]]])
(buri.test sealed-trans-survives-rebinding (buri.eq2-run (value buri.eq2-sealed) [trans [refl [var 0]] [refl [var 1]]]) none)
(buri.test sealed-sym-survives-rebinding (buri.eq2-run (value buri.eq2-sealed) [sym [refl [var 0]]]) [some [[var 0] [var 0]]])
(buri.test sealed-cong-survives-rebinding (buri.eq2-run (value buri.eq2-sealed) [cong [refl [var 0]] [refl [var 1]]]) [some [[app [var 0] [var 1]] [app [var 0] [var 1]]]])
\\ Native synchronization harness; its authority does not enter the capsule.
(define buri.eq2-concurrent Capsule ->
 (let Harness ((foreign scm.eval)
       [read [open-input-string
"(lambda (capsule)
 (let ((m (make-mutex)) (cv (make-condition)) (phase 0) (done #f)
       (old (top-level-value 'kl:buri.eq2-derive)) (worker-failed #f) (answer #f))
   (fork-thread (lambda ()
     (mutex-acquire m)
     (guard (e (else
       (set! worker-failed #t)
       (guard (ignored (else #f)) (set-top-level-value! 'kl:buri.eq2-derive old))
       (set! phase 2) (condition-broadcast cv) (mutex-release m)))
       (set-top-level-value! 'kl:buri.eq2-derive (lambda (x) 'poison))
       (set! phase 1) (condition-broadcast cv)
       (let wait () (unless done (condition-wait cv m) (wait)))
       (set-top-level-value! 'kl:buri.eq2-derive old)
       (set! phase 2) (condition-broadcast cv) (mutex-release m))))
   (mutex-acquire m)
   (let wait () (when (< phase 1) (condition-wait cv m) (wait)))
   (mutex-release m)
   (set! answer (guard (e (else #f))
     (and (not worker-failed)
          (equal? ((top-level-value 'kl:buri.eq2-derive) '()) 'poison)
          (equal? (capsule '(refl (var 0))) '(some ((var 0) (var 0))))
          (equal? (capsule '(trans (refl (var 0)) (refl (var 1)))) 'none))))
   (mutex-acquire m) (set! done #t) (condition-broadcast cv)
   (let wait () (when (< phase 2) (condition-wait cv m) (wait)))
   (mutex-release m) answer))"]])
  ((foreign scm.eval) [Harness [quote Capsule]])))
(buri.test sealed-concurrent-deriver-rebinding (buri.eq2-concurrent (value buri.eq2-sealed)) true)
(buri.done)
