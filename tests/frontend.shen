(load "buri.shen")
(load "shen/wire.shen")
(load "shen/export-encoder-kl.shen")
(load "tests/support.shen")
(buri.test kl-tag-nil (buri.kl-node []) [nil])
(buri.test kl-tag-number (buri.kl-node 8) [num 8])
(buri.test kl-tag-symbol (buri.kl-node V7) [sym V7])
(buri.test kl-tag-empty-string (buri.kl-node "") [text []])
(buri.test kl-tag-byte-string (buri.kl-node (cn "A" (n->string 0))) [text [65 0]])
(buri.test kl-tag-improper-pair (buri.kl-node [x | 3]) [pair [sym x] [num 3]])
(buri.test kl-tag-string-symbol-distinct (= (buri.kl-node x) (buri.kl-node "x")) false)
(buri.test kl-tag-refuses-float (trap-error (do (buri.kl-node 1.5) false) (/. E true)) true)
(buri.done)
