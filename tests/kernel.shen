(load "buri.shen")
(load "proofs/compiler.shen")
(load "tests/support.shen")
(buri.test generic-compiler (buri.accepted? (buri.prove)) true)
(buri.test proof-exhaustion (buri.check-bundle (buri.theory) (buri.compiler-bundle) 0) [unknown proof-budget])
(buri.test different-theory (buri.check-bundle other (buri.compiler-bundle) 100) [rejected theory-mismatch])
(buri.test malformed-proof (buri.rejected? (buri.check-bundle (buri.theory) [[theorem bad [] [zero] [zero] arbitrary]] 10)) true)
(buri.test no-axiom (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem false [] [zero] [succ [zero]] [direct [[rewrite [] forward [axiom trust-me] []]]]]] 10)) true)
(buri.test wrong-conclusion (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem false [] [zero] [succ [zero]] [direct []]]] 10)) true)
(buri.test wrong-sort (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem false [] [zero] [halt] [direct []]]] 10)) true)
(buri.test unbound-variable (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem false [] [v x] [v x] [direct []]]] 10)) true)
(buri.test circular-lemma (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem circular [[n nat]] [v n] [zero]
 [direct [[rewrite [] forward [lemma circular] [[n [v n]]]]]]]] 10)) true)
(buri.test wrong-substitution (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem false [[n nat]] [eval [lit [v n]]] [v n]
 [direct [[rewrite [] forward [definition eval-lit] [[n [halt]]]]]]]] 10)) true)
(buri.test extra-substitution (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem false [[n nat]] [eval [lit [v n]]] [v n]
 [direct [[rewrite [] forward [definition eval-lit] [[n [v n]] [extra [zero]]]]]]]] 10)) true)
(buri.test missing-case (buri.rejected? (buri.check-bundle (buri.theory)
 [(buri.swap mul bogus (buri.compiler-theorem))] 100)) true)
(buri.test capture (buri.rejected? (buri.check-bundle (buri.theory)
 [(buri.swap a k (buri.compiler-theorem))] 100)) true)
(buri.test forged-hypothesis (buri.rejected? (buri.check-bundle (buri.theory)
 [(buri.swap [hypothesis a] [hypothesis e] (buri.compiler-theorem))] 100)) true)
(buri.test swapped-instruction (buri.rejected? (buri.check-bundle (buri.theory)
 [(buri.swap plus times (buri.compiler-theorem))] 100)) true)
(buri.test duplicate-theorem (buri.rejected? (buri.check-bundle (buri.theory)
 [(buri.compiler-theorem) (buri.compiler-theorem)] 100)) true)
(buri.test stale-code-claim (buri.rejected? (buri.check-bundle (buri.theory)
 [(buri.swap compile eval (buri.compiler-theorem))] 100)) true)
(buri.test negative-budget (buri.rejected? (buri.check-bundle (buri.theory) [] -1)) true)
(buri.test open-rule (buri.rejected? (buri.check-bundle (buri.theory)
 [[theorem invalid [] [zero] [zero] [direct [[rewrite [] forward [definition absent] []]]]]] 10)) true)
(buri.test nat-add (buri.normalize [nadd [succ [zero]] [succ [succ [zero]]]] 100)
 [normal [succ [succ [succ [zero]]]]])
(buri.test stack-fault (buri.normalize [run [plus [halt]] [nil]] 100) [normal [fault]])
(buri.test singleton-fault (buri.normalize [run [times [halt]] [cons [zero] [nil]]] 100) [normal [fault]])
(buri.test normalize-budget (buri.normalize [eval [lit [zero]]] 0) [unknown normalization-budget])
(buri.test no-host-eval (buri.normalize [eval-kl [zero]] 100) [rejected malformed-ground-term])
(buri.test no-test-as-proof (= (buri.evidence-kind [passed conformance 1000000]) generic-equation) false)
(buri.test no-boolean-proof (= (buri.evidence-kind true) generic-equation) false)
(buri.test no-ground-as-proof (= (buri.evidence-kind [accepted ground-replay anything]) generic-equation) false)

\\ Exhaustive small independent execution comparisons complement the theorem.
(define buri.small-exprs -> [[lit [zero]] [lit [succ [zero]]] [lit [succ [succ [zero]]]]])
(define buri.check-small A B ->
  (do (buri.check-small-expression [add A B]) (buri.check-small-expression [mul A B])))
(define buri.check-small-expression E ->
  (buri.test finite-execution
    (buri.normalize [run [compile E [halt]] [cons [succ [zero]] [nil]]] 200)
    (buri.normalize [ok [cons [eval E] [cons [succ [zero]] [nil]]]] 200)))
(map (/. A (map (/. B (buri.check-small A B)) (buri.small-exprs))) (buri.small-exprs))
(buri.done)
