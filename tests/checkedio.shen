(load "buri.shen")
(load "shen/wire.shen")
(load "shen/export-encoder-kl.shen")
(load "shen/observe-encoder.shen")
(load "tests/support.shen")
(buri.test checked-write-return (buri.checked-write "_build/checked.txt" "payload") "payload")
(buri.test checked-write-persisted (read-file-as-string "_build/checked.txt") "payload")
(buri.test checked-empty-return (buri.checked-write "_build/checked.txt" "") "")
(buri.test checked-empty-persisted (read-file-as-string "_build/checked.txt") "")
(set *hush* true)
(buri.test unchecked-hush-return (write-to-file "_build/hushed.txt" "payload") "payload")
(buri.test unchecked-hush-empty (read-file-as-string "_build/hushed.txt") "")
(buri.test checked-hush-rejected (trap-error (do (buri.checked-write "_build/hushed.txt" "payload") false) (/. E true)) true)
(buri.test checked-hush-empty-valid (buri.checked-write "_build/hushed.txt" "") "")
(buri.test checked-hush-still-empty (read-file-as-string "_build/hushed.txt") "")
(buri.test observer-hush-rejected (trap-error (do (buri.observe-encoder "shen/wire.shen" "_build/hushed-observed.bits" "_build/hushed-observed.sexp") false) (/. E true)) true)
(set *hush* false)
(buri.test checked-recovery-return (buri.checked-write "_build/checked.txt" "recovered") "recovered")
(buri.test checked-recovery-persisted (read-file-as-string "_build/checked.txt") "recovered")
(buri.test checked-invalid-path (trap-error (do (buri.checked-write "_build/no-such-parent/path.txt" "payload") false) (/. E true)) true)
(buri.done)
