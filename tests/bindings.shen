(load "buri.shen")
(load "shen/export-encoder-kl.shen")
(load "shen/observe-encoder.shen")
(load "shen/binding-guard.shen")
(load "tests/support.shen")
(buri.observe-encoder "shen/wire.shen" "_build/bindings.bits" "_build/bindings.sexp")
(buri.test observed-single-read-source (value buri.observed-source) (read-file-as-string "shen/wire.shen"))
(set buri.seal (buri.seal-encoder))
(buri.test bindings-valid (buri.bindings-current? (value buri.seal) (buri.binding-names)) true)
(buri.test bindings-execute (buri.guarded-wire (value buri.seal) []) "00")
(buri.test bindings-omission (buri.bindings-current? (tl (value buri.seal)) (buri.binding-names)) false)
(buri.test bindings-extra (buri.bindings-current? (cons [extra 1] (value buri.seal)) (buri.binding-names)) false)
(put buri.wire shen.source [defun buri.wire [X] "fake"])
(buri.test bindings-metadata-independent (buri.guarded-wire (value buri.seal) []) "00")
(define buri.digits? _ -> false)
(buri.test bindings-transitive-helper-changed (buri.bindings-current? (value buri.seal) (buri.binding-names)) false)
(buri.test bindings-refuse-before-call (trap-error (do (buri.guarded-wire (value buri.seal) []) false) (/. E true)) true)
(buri.done)
