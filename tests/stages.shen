(load "buri.shen")
(load "shen/equality-core.shen")
(load "tests/support.shen")
(buri.test eq-refl (buri.eq2-derive [refl [var 0]]) [some [[var 0] [var 0]]])
(buri.test eq-sym (buri.eq2-derive [sym [refl [const 7]]]) [some [[const 7] [const 7]]])
(buri.test eq-trans (buri.eq2-derive [trans [sym [refl [var 0]]] [refl [var 0]]]) [some [[var 0] [var 0]]])
(buri.test eq-trans-mismatch (buri.eq2-derive [trans [refl [var 0]] [refl [var 1]]]) none)
(buri.test eq-cong (buri.eq2-derive [cong [refl [const 0]] [refl [var 1]]]) [some [[app [const 0] [var 1]] [app [const 0] [var 1]]]])
(buri.test eq-nested (buri.eq2-derive [sym [trans [cong [refl [var 0]] [refl [var 1]]] [refl [app [var 0] [var 1]]]]]) [some [[app [var 0] [var 1]] [app [var 0] [var 1]]]])
(buri.test eq-no-artifact-rule (buri.eq2-derive [instance 0 []]) none)
(buri.test eq-no-rules-field (buri.eq2-derive [rules [[var 0] [var 1]] [instance 0 []]]) none)
(buri.test eq-no-rule-under-sym (buri.eq2-derive [sym [instance 0 []]]) none)
(buri.test eq-unknown (buri.eq2-derive unknown) none)
(buri.test eq-empty (buri.eq2-derive []) none)
(buri.test eq-extra-field (buri.eq2-derive [refl [var 0] extra]) none)
(buri.test eq-short-sym (buri.eq2-derive [sym]) none)
(buri.test eq-short-trans (buri.eq2-derive [trans [refl [var 0]]]) none)
(buri.test eq-propagate-invalid-left (buri.eq2-derive [trans unknown [refl [var 0]]]) none)
(buri.test eq-propagate-invalid-right (buri.eq2-derive [cong [refl [var 0]] unknown]) none)
(buri.test eq-large-index-same (buri.eq2-derive [trans [refl [var 9007199254740995]] [refl [var 9007199254740995]]]) [some [[var 9007199254740995] [var 9007199254740995]]])
(buri.test eq-large-index-distinct (buri.eq2-derive [trans [refl [var 9007199254740995]] [refl [var 9007199254740996]]]) none)
(define buri.eq2-nested 0 P -> P N P -> (buri.eq2-nested (- N 1) [sym P]))
(buri.test eq-recursive-100 (buri.eq2-derive (buri.eq2-nested 100 [refl [var 0]])) [some [[var 0] [var 0]]])
(set buri.eq2-executed false)
(buri.test eq-payload-inert (buri.eq2-derive [refl [eval-kl [set buri.eq2-executed true]]]) [some [[eval-kl [set buri.eq2-executed true]] [eval-kl [set buri.eq2-executed true]]]])
(buri.test eq-no-payload-execution (value buri.eq2-executed) false)
(buri.test fresh-three-collisions
 (let Saved (value shen.*gensym*)
      A (gensym arg) B (gensym arg) C (gensym arg)
      Reset (set shen.*gensym* Saved)
      Name (_scm.fresh-call-variable [A B C])
  (and (not (= Name A)) (and (not (= Name B)) (not (= Name C))))) true)
(load "shen/observe-encoder.shen")
(set buri.observed [])
(buri.test loader-first-frontend-rejected
 (trap-error (buri.observe-forms [[tc -] [42] [define buri.stages-never-second -> 2] [define buri.stages-never-third -> 3]]) (/. E rejected)) rejected)
(buri.test loader-first-no-publication (length (value buri.observed)) 0)
(buri.test loader-first-no-later-installation (trap-error (buri.stages-never-third) (/. E rejected)) rejected)
(set buri.observed [])
(buri.test loader-third-frontend-rejected
 (trap-error (buri.observe-forms [[tc -] [define buri.stages-first -> 1] [define buri.stages-second -> 2] [42]]) (/. E rejected)) rejected)
(buri.test loader-third-keeps-two-records (length (value buri.observed)) 2)
(buri.test loader-third-keeps-two-installations (+ (buri.stages-first) (buri.stages-second)) 3)
(buri.done)
