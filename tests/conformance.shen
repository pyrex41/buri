(load "buri.shen")
(load "ports/shen-scheme.shen")
(load "tests/support.shen")
(define buri.native-pass? [passed sampled-agreement _ _] -> true _ -> false)
(define buri.port-test Name E -> (let R (buri.compare-native E 200)
 (if (buri.native-pass? R) (set buri.tests (+ 1 (value buri.tests)))
     (do (output "FAIL ~A ~S~%" Name R) (simple-error "Port mismatch")))))
(buri.port-test literal [literal [int 42]])
(buri.port-test exact-large-int [primitive + [[literal [int 9007199254740992]] [literal [int 1]]]])
(buri.port-test huge-product [primitive * [[literal [int 9223372036854775807]] [literal [int 9223372036854775807]]]])
(buri.port-test negative [primitive - [[literal [int 0]] [literal [int 42]]]])
(buri.port-test true [literal [bool true]])
(buri.port-test false [literal [bool false]])
(buri.port-test bytes [literal [str "abc"]])
(buri.port-test symbol [literal [sym alpha]])
(buri.port-test empty [literal nil])
(buri.port-test improper-pair [literal [pair [int 1] [int 2]]])
(buri.port-test identity [apply [lambda x [var x]] [literal [int 7]]])
(buri.port-test lexical [let x [literal [int 10]] [let f [lambda y [primitive + [[var x] [var y]]]] [let x [literal [int 99]] [apply [var f] [literal [int 2]]]]]])
(buri.port-test currying [apply [apply [lambda x [lambda y [primitive + [[var x] [var y]]]]] [literal [int 4]]] [literal [int 5]]])
(buri.port-test shadowing [let x [literal [int 1]] [let x [literal [int 2]] [var x]]])
(buri.port-test lazy-true [if [literal [bool true]] [literal [int 1]] [raise [literal [str "bad"]]]])
(buri.port-test lazy-false [if [literal [bool false]] [raise [literal [str "bad"]]] [literal [int 2]]])
(buri.port-test catch [trap [raise [literal [str "hello"]]] [lambda e [var e]]])
(buri.port-test handler-not-run [trap [literal [int 8]] [lambda e [raise [literal [str "unused"]]]]])
(buri.port-test function-before-argument [apply [raise [literal [str "function"]]] [raise [literal [str "argument"]]]])
(buri.port-test arguments-left-first [primitive + [[raise [literal [str "left"]]] [raise [literal [str "right"]]]]])
(buri.port-test freeze [let x [literal [int 10]] [let f [freeze [var x]] [let x [literal [int 99]] [thaw [var f]]]]])
(buri.port-test freeze-lazy [let x [freeze [raise [literal [str "unused"]]]] [literal [int 2]]])
(buri.port-test head [primitive hd [[primitive cons [[literal [int 2]] [literal nil]]]]])
(buri.port-test tail [primitive tl [[primitive cons [[literal [int 2]] [literal [int 3]]]]]])
(buri.port-test structural-equality [primitive = [[literal [pair [int 1] nil]] [primitive cons [[literal [int 1]] [literal nil]]]]])
(buri.port-test inequality [primitive = [[literal [int 1]] [literal [str "1"]]]])
(buri.port-test less [primitive < [[literal [int 1]] [literal [int 2]]]])
(buri.port-test cons-recognizer [primitive cons? [[literal nil]]])
(buri.port-test number-recognizer [primitive number? [[literal [int 1]]]])
(buri.port-test string-recognizer [primitive string? [[literal [str "x"]]]])
(define buri.port-pairs Xs Ys ->
 (map (/. X (map (/. Y
   (do (buri.port-test generated-add [primitive + [[literal [int X]] [literal [int Y]]]])
     (do (buri.port-test generated-subtract [primitive - [[literal [int X]] [literal [int Y]]]])
       (buri.port-test generated-multiply [primitive * [[literal [int X]] [literal [int Y]]]])))) Ys)) Xs))
(buri.port-pairs [-3 -1 0 1 3] [-3 -1 0 1 3])
(buri.done)
