(load "buri.shen")
(load "shen/wire.shen")
(load "shen/observe-encoder.shen")
(load "shen/observe-constructor.shen")
(load "tests/support.shen")
(buri.observe-constructor "shen/sealed-encoder.shen" "_build/constructor-tests.bits")
(buri.test constructor-captures-all (length (value buri.observed)) 10)
(buri.test constructor-source-snapshot (read-file-as-string "_build/constructor-tests.bits.source")
 (read-file-as-string "shen/sealed-encoder.shen"))
(buri.test native-boolean-true (buri.native-node true) [bool 1])
(buri.test native-boolean-false (buri.native-node false) [bool 0])
(buri.test native-symbol-distinct (buri.native-node symbol) [sym symbol])
(buri.test native-text-distinct (buri.native-node "true") [text [116 114 117 101]])
(buri.test native-pair (buri.native-node [true false]) [pair [bool 1] [pair [bool 0] [nil]]])
(buri.test constructor-definition (buri.sealed-definition [define [f X Y] [cons X Y]]) [f [lambda [X Y] [cons X Y]]])
(buri.test constructor-targets
 (buri.sealed-targets [[source [define [a X] X]] [source [define [b Y] Y]] [source [define [c Z] Z]]])
 [[a [lambda [X] X]] [b [lambda [Y] Y]] [c [lambda [Z] Z]]])
(buri.test constructor-append (buri.sealed-append [a b c] [d e]) [a b c d e])
(buri.test constructor-append-empty (buri.sealed-append [] [tail]) [tail])
(buri.test constructor-reject-missing (trap-error (do (buri.sealed-program []) false) (/. E true)) true)
(buri.test constructor-reject-definition (trap-error (do (buri.sealed-definition []) false) (/. E true)) true)
(buri.test constructor-reject-improper-append (trap-error (do (buri.sealed-append [a | b] []) false) (/. E true)) true)
(buri.test constructor-request (buri.sealed-request [some program])
 [eval [quote [some program]] [environment [quote [only [chezscheme] | (buri.sealed-imports)]]]])
(buri.test constructor-imports-no-inexact (element? inexact (buri.sealed-imports)) false)
(buri.test constructor-imports-no-eq (element? eq? (buri.sealed-imports)) false)
(buri.test constructor-imports-no-dynamic-eval (element? eval (buri.sealed-imports)) false)
(buri.done)
