(load "buri.shen")
(load "shen/wire.shen")
(load "shen/observe-encoder.shen")
(load "shen/observe-constructor.shen")
(load "tests/support.shen")
(buri.observe-constructor "shen/observe-constructor.shen" "_build/bootstrap-tests.bits")
(buri.test bootstrap-capture-count (length (value buri.observed)) 4)
(buri.test bootstrap-source (read-file-as-string "_build/bootstrap-tests.bits.source") (read-file-as-string "shen/observe-constructor.shen"))
(buri.test bootstrap-true (buri.native-node true) [bool 1])
(buri.test bootstrap-false (buri.native-node false) [bool 0])
(buri.test bootstrap-text (buri.native-node "true") [text [116 114 117 101]])
(buri.test bootstrap-symbol (buri.native-node alpha) [sym alpha])
(buri.test bootstrap-number (buri.native-node 256) [num 256])
(buri.test bootstrap-negative (buri.native-node -17) [num -17])
(buri.test bootstrap-empty (buri.native-node []) [nil])
(buri.test bootstrap-byte-empty (buri.native-bytes "") [])
(buri.test bootstrap-byte-list (buri.native-bytes "Az") [65 122])
(buri.test bootstrap-nested (buri.native-node [true [false | alpha]])
 [pair [bool 1] [pair [pair [bool 0] [sym alpha]] [nil]]])
(buri.done)
