(load "buri.shen")
(load "shen/export-encoder-kl.shen")
(load "shen/observe-encoder.shen")
(load "shen/sealed-encoder.shen")
(load "tests/support.shen")
(buri.observe-encoder "shen/wire.shen" "_build/sealed-tests.bits" "_build/sealed-tests.sexp")
(set buri.capsule (buri.make-sealed-encoder (reverse (value buri.observed))))
(buri.test sealed-nil ((value buri.capsule) []) "00")
(buri.test sealed-pair ((value buri.capsule) [alpha 42 -17]) (buri.wire [alpha 42 -17]))
(buri.test sealed-reject-boolean (trap-error (do ((value buri.capsule) true) false) (/. E true)) true)
(buri.test sealed-large-integer ((value buri.capsule) 9007199254740995) (buri.wire 9007199254740995))
(define buri.inexact-test X -> ((foreign scm.inexact) X))
(buri.test sealed-reject-float (trap-error (do ((value buri.capsule) (buri.inexact-test 1)) false) (/. E true)) true)
(buri.test sealed-reject-string (trap-error (do ((value buri.capsule) "x") false) (/. E true)) true)
(buri.test sealed-no-eval (trap-error (do (buri.sealed-eval [lambda [x] [eval x]]) false) (/. E true)) true)
(buri.test sealed-no-global (trap-error (do (buri.sealed-eval [lambda [x] [(intern "kl:value") x]]) false) (/. E true)) true)
(buri.test sealed-no-mutation (trap-error (do (buri.sealed-eval [lambda [x] [set! x 0]]) false) (/. E true)) true)
(buri.test sealed-no-thread (trap-error (do (buri.sealed-eval [lambda [x] [fork-thread x]]) false) (/. E true)) true)
(buri.test sealed-no-unknown (trap-error (do (buri.sealed-eval [lambda [x] [missing-helper x]]) false) (/. E true)) true)
(buri.test sealed-missing-record (trap-error (do (buri.make-sealed-encoder (tl (reverse (value buri.observed)))) false) (/. E true)) true)
(define buri.sealed-byte-entry [letrec Bindings _] ->
 (buri.sealed-eval [letrec Bindings (intern "kl:buri.wire-byte")]))
(set buri.byte-capsule (buri.sealed-byte-entry (buri.sealed-program (reverse (value buri.observed)))))
(define buri.sealed-half N -> (if (< N 2) 0 (+ 1 (buri.sealed-half (- N 2)))))
(define buri.sealed-oracle N 0 -> ""
 N Count -> (let H (buri.sealed-half N)
  (cn (if (= N (* H 2)) "0" "1") (buri.sealed-oracle H (- Count 1)))))
(define buri.sealed-byte-call F N C -> ((foreign scm.eval) [[quote F] N C]))
(define buri.sealed-counts N C ->
 (and (= (buri.sealed-byte-call (value buri.byte-capsule) N C) (buri.sealed-oracle N C))
      (if (= C 0) true (buri.sealed-counts N (- C 1)))))
(define buri.sealed-bytes 256 -> true
 N -> (do (buri.test [sealed-byte N] (buri.sealed-counts N 8) true)
          (buri.sealed-bytes (+ N 1))))
(buri.sealed-bytes 0)
(buri.test sealed-large-halving-regression
 (buri.sealed-byte-call (value buri.byte-capsule) 9007199254740995 8) "11000000")
\\ Native synchronization harness only. No harness capabilities enter capsule.
\\ Install the test harness in Chez, then pass the capsule as an opaque value.
(define buri.sealed-concurrent Capsule ->
 (let Harness ((foreign scm.eval)
       [read [open-input-string
"(lambda (capsule)
 (let ((m (make-mutex)) (cv (make-condition)) (ready #f) (done #f)
       (old (top-level-value 'kl:buri.wire)) (answer #f)
       (expected (capsule '(1))))
   (fork-thread (lambda ()
     (mutex-acquire m)
     (set-top-level-value! 'kl:buri.wire (lambda (x) 'poison))
     (set! ready #t) (condition-broadcast cv)
     (let wait () (unless done (condition-wait cv m) (wait)))
     (set-top-level-value! 'kl:buri.wire old)
     (set! ready #f) (condition-broadcast cv) (mutex-release m)))
   (mutex-acquire m)
   (let wait () (unless ready (condition-wait cv m) (wait)))
   (mutex-release m)
   (set! answer (and (equal? ((top-level-value 'kl:buri.wire) '()) 'poison)
                    (equal? (capsule '()) (list->string '(#\0 #\0)))
                    (equal? (capsule '(1)) expected)))
   (mutex-acquire m) (set! done #t) (condition-broadcast cv)
   (let wait () (when ready (condition-wait cv m) (wait)))
   (mutex-release m) answer))"]])
  ((foreign scm.eval) [Harness [quote Capsule]])))
(buri.test sealed-concurrent-global-rebinding (buri.sealed-concurrent (value buri.capsule)) true)
(set buri.expected (buri.wire [alpha 42 -17]))
(define buri.wire _ -> "poison")
(define buri.wire-byte _ _ -> "poison")
(define buri.wire-string _ -> "poison")
(define buri.digits? _ -> false)
(define buri.exact-integer? _ -> false)
(buri.test sealed-survives-all-encoder-rebindings ((value buri.capsule) [alpha 42 -17]) (value buri.expected))
(buri.done)
