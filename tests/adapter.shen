(load "buri.shen")
(load "shen/wire.shen")
(load "shen/observe-encoder.shen")
(load "shen/observe-constructor.shen")
(load "tests/support.shen")
(buri.observe-constructor "shen/export-encoder-kl.shen" "_build/adapter-tests.bits")
(buri.test adapter-captures-all (length (value buri.observed)) 3)
(buri.test adapter-source-snapshot (read-file-as-string "_build/adapter-tests.bits.source")
 (read-file-as-string "shen/export-encoder-kl.shen"))
(buri.test adapter-empty-bytes (buri.kl-bytes "") [])
(buri.test adapter-byte-spelling (buri.kl-bytes "Az") [65 122])
(buri.test adapter-null (buri.kl-node []) [nil])
(buri.test adapter-symbol (buri.kl-node alpha) [sym alpha])
(buri.test adapter-number (buri.kl-node 256) [num 256])
(buri.test adapter-negative (buri.kl-node -17) [num -17])
(buri.test adapter-text (buri.kl-node "alpha") [text [97 108 112 104 97]])
(buri.test adapter-empty-text (buri.kl-node "") [text []])
(buri.test adapter-improper-pair (buri.kl-node [1 | tail]) [pair [num 1] [sym tail]])
(buri.test adapter-nested (buri.kl-node [[alpha] "z"])
 [pair [pair [sym alpha] [nil]] [pair [text [122]] [nil]]])
(buri.done)
