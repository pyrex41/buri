#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
root=$(pwd)
mkdir -p _build/rocq
rm -f _build/EquationBridge.v _build/NativeOutput.v _build/compiler-output.sexp \
 _build/native-capture.bits _build/native-capture.sexp _build/NativeCapture.v _build/EncoderSource.v \
 _build/encoder-kl.bits _build/encoder-kl.sexp _build/EncoderKLambda.v \
 _build/observed-encoder.bits.source _build/observed-encoder.bits _build/observed-encoder.sexp _build/ObservedCapture.v _build/sealed.bits _build/sealed.bits.sexp _build/SealedInput.v _build/constructor.bits _build/constructor.bits.source _build/constructor.bits.sexp _build/ConstructorInput.v _build/adapter.bits _build/adapter.bits.source _build/adapter.bits.sexp _build/AdapterInput.v _build/bootstrap.bits _build/bootstrap.bits.source _build/bootstrap.bits.sexp _build/BootstrapInput.v _build/observer.bits _build/observer.bits.source _build/observer.bits.sexp _build/ObserverInput.v _build/compiler-pass.bits _build/compiler-pass.bits.source _build/compiler-pass.bits.sexp _build/CompilerPassInput.v _build/CheckedIOInput.v _build/StockDivisionInput.v _build/OrderCallInput.v _build/ObserverFormsInput.v _build/IOReadInput.v _build/io-read.bits _build/io-read.bits.source _build/io-read.bits.sexp _build/order-call.bits _build/order-call.bits.source _build/order-call.bits.sexp _build/KernelListInput.v _build/kernel-list.bits _build/kernel-list.bits.source _build/kernel-list.bits.sexp _build/EqualityCoreInput.v _build/EqualitySealInput.v _build/equality-core.bits _build/equality-core.bits.source _build/equality-core.bits.sexp _build/equality-core-for-seal.bits _build/equality-core-for-seal.bits.source _build/equality-core-for-seal.bits.sexp _build/equality-seal.bits _build/equality-seal.bits.source _build/equality-seal.bits.sexp
scripts/rocq coqc --version > _build/rocq-version.log
grep -q 'version 8.18.0' _build/rocq-version.log || { cat _build/rocq-version.log; exit 1; }
# Require a fresh image and regenerate the bridge from actual loaded equations.
scripts/shen -l buri.shen -l proofs/compiler.shen -l shen/export-rocq.shen \
 -e '(buri.export-rocq "_build/EquationBridge.v")' -e '(output "BURI_EXPORT_OK~%")' > _build/export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/export.log || { cat _build/export.log; exit 1; }
diff -u rocq/EquationBridge.v _build/EquationBridge.v
scripts/shen -l buri.shen -l ports/compiler-schemas.shen -l shen/export-native.shen \
 -e '(buri.export-native "_build/NativeOutput.v" "_build/compiler-output.sexp")' -e '(output "BURI_EXPORT_OK~%")' > _build/native-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/native-export.log || { cat _build/native-export.log; exit 1; }
diff -u rocq/NativeOutput.v _build/NativeOutput.v
diff -u ports/compiler-output.sexp _build/compiler-output.sexp
scripts/shen -l buri.shen -l ports/compiler-schemas.shen -l shen/export-wire.shen \
 -e '(buri.capture-wire "_build/native-capture.bits" "_build/native-capture.sexp")' -e '(output "BURI_EXPORT_OK~%")' > _build/wire-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/wire-export.log || { cat _build/wire-export.log; exit 1; }
diff -u ports/native-capture.bits _build/native-capture.bits
diff -u ports/native-capture.sexp _build/native-capture.sexp
python3 scripts/package-wire.py _build/native-capture.bits _build/NativeCapture.v
python3 scripts/check-wire-package.py _build/native-capture.bits _build/NativeCapture.v
diff -u rocq/NativeCapture.v _build/NativeCapture.v
python3 scripts/package-encoder.py shen/wire.shen _build/EncoderSource.v
python3 scripts/check-encoder-package.py shen/wire.shen _build/EncoderSource.v
diff -u rocq/EncoderSource.v _build/EncoderSource.v
scripts/shen -l buri.shen -l shen/wire.shen -l shen/export-encoder-kl.shen \
 -e '(buri.capture-encoder-kl "_build/encoder-kl.bits" "_build/encoder-kl.sexp")' -e '(output "BURI_EXPORT_OK~%")' > _build/encoder-kl-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/encoder-kl-export.log || { cat _build/encoder-kl-export.log; exit 1; }
diff -u ports/encoder-kl.bits _build/encoder-kl.bits
diff -u ports/encoder-kl.sexp _build/encoder-kl.sexp
python3 scripts/package-frontend.py _build/encoder-kl.bits _build/EncoderKLambda.v
python3 scripts/check-frontend-package.py _build/encoder-kl.bits _build/EncoderKLambda.v
diff -u rocq/EncoderKLambda.v _build/EncoderKLambda.v
scripts/shen -l buri.shen -l shen/export-encoder-kl.shen -l shen/observe-encoder.shen \
 -e '(buri.observe-encoder "shen/wire.shen" "_build/observed-encoder.bits" "_build/observed-encoder.sexp")' \
 -l shen/sealed-encoder.shen -e '(buri.export-sealed (reverse (value buri.observed)) "_build/sealed.bits")' \
 -e '(output "BURI_EXPORT_OK~%")' > _build/observed-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/observed-export.log || { cat _build/observed-export.log; exit 1; }
diff -u shen/wire.shen _build/observed-encoder.bits.source
diff -u ports/observed-encoder.bits _build/observed-encoder.bits
diff -u ports/observed-encoder.sexp _build/observed-encoder.sexp
python3 scripts/package-observed.py _build/observed-encoder.bits _build/ObservedCapture.v
python3 scripts/check-observed-package.py _build/observed-encoder.bits _build/ObservedCapture.v
diff -u rocq/ObservedCapture.v _build/ObservedCapture.v
diff -u ports/sealed.bits _build/sealed.bits
diff -u ports/sealed.bits.sexp _build/sealed.bits.sexp
python3 scripts/package-sealed.py _build/sealed.bits _build/SealedInput.v
python3 scripts/check-sealed-package.py _build/sealed.bits _build/SealedInput.v
diff -u rocq/SealedInput.v _build/SealedInput.v
scripts/shen -l buri.shen -l shen/wire.shen -l shen/observe-encoder.shen -l shen/observe-constructor.shen \
 -e '(buri.observe-constructor "shen/sealed-encoder.shen" "_build/constructor.bits")' \
 -e '(output "BURI_CONSTRUCTOR_EXPORT_OK~%")' > _build/constructor-export.log 2>&1
grep -qx 'BURI_CONSTRUCTOR_EXPORT_OK' _build/constructor-export.log || { cat _build/constructor-export.log; exit 1; }
diff -u shen/sealed-encoder.shen _build/constructor.bits.source
diff -u ports/constructor.bits _build/constructor.bits
diff -u ports/constructor.bits.sexp _build/constructor.bits.sexp
python3 scripts/package-constructor.py _build/constructor.bits _build/ConstructorInput.v
python3 scripts/check-constructor-package.py _build/constructor.bits _build/ConstructorInput.v
diff -u rocq/ConstructorInput.v _build/ConstructorInput.v
scripts/shen -l buri.shen -l shen/wire.shen -l shen/observe-encoder.shen -l shen/observe-constructor.shen \
 -e '(buri.observe-constructor "shen/export-encoder-kl.shen" "_build/adapter.bits")' \
 -e '(output "BURI_ADAPTER_EXPORT_OK~%")' > _build/adapter-export.log 2>&1
grep -qx 'BURI_ADAPTER_EXPORT_OK' _build/adapter-export.log || { cat _build/adapter-export.log; exit 1; }
diff -u shen/export-encoder-kl.shen _build/adapter.bits.source
diff -u ports/adapter.bits _build/adapter.bits
diff -u ports/adapter.bits.sexp _build/adapter.bits.sexp
python3 scripts/package-adapter.py _build/adapter.bits _build/AdapterInput.v
python3 scripts/check-adapter-package.py _build/adapter.bits _build/AdapterInput.v
diff -u rocq/AdapterInput.v _build/AdapterInput.v
python3 scripts/check-upstream-pass.py
for profile in bootstrap observer compiler_pass order_call kernel_list io_read equality_core equality_seal eq1_base eq1_equations eq1_theory eq1_kernel; do
 case "$profile" in
  bootstrap) source=shen/observe-constructor.shen; capture=bootstrap; module=BootstrapInput ;;
  observer) source=shen/observe-encoder.shen; capture=observer; module=ObserverInput ;;
  compiler_pass) source=ports/compiler-merge.shen; capture=compiler-pass; module=CompilerPassInput ;;
  order_call) source=ports/compiler-order.shen; capture=order-call; module=OrderCallInput ;;
  kernel_list) source=ports/kernel-list.shen; capture=kernel-list; module=KernelListInput ;;
  io_read) source=ports/io-read.shen; capture=io-read; module=IOReadInput ;;
  equality_core) source=shen/equality-core.shen; capture=equality-core; module=EqualityCoreInput ;;
  equality_seal) source=shen/sealed-equality.shen; capture=equality-seal; module=EqualitySealInput ;;
  # BURI/EQ-1 acceptance kernel and the helpers it calls, one capture per source file.
  eq1_base) source=shen/base.shen; capture=eq1-base; module=EqualityInductionBaseInput ;;
  eq1_equations) source=shen/equations.shen; capture=eq1-equations; module=EqualityInductionEquationsInput ;;
  eq1_theory) source=spec/arithmetic.shen; capture=eq1-theory; module=EqualityInductionTheoryInput ;;
  eq1_kernel) source=shen/kernel.shen; capture=eq1-kernel; module=EqualityInductionKernelInput ;;
 esac
 if [ "$profile" = equality_seal ]; then
  # Build and activate from the same core records whose literal targets are checked.
  scripts/shen -l buri.shen -l shen/wire.shen -l shen/observe-encoder.shen -l shen/observe-constructor.shen \
   -e '(buri.observe-constructor "shen/equality-core.shen" "_build/equality-core-for-seal.bits")' \
   -e '(set buri.eq2-authority-records (reverse (value buri.observed)))' \
   -e '(buri.observe-constructor "shen/sealed-equality.shen" "_build/equality-seal.bits")' \
   -e '(set buri.eq2-checked-procedure (buri.make-sealed-eq2 (value buri.eq2-authority-records)))' \
   -e '(if (= ((value buri.eq2-checked-procedure) [refl [var 0]]) [some [[var 0] [var 0]]]) (output "BURI_PROVENANCE_EXPORT_OK~%") (simple-error "EQ2 sealed smoke failed"))' > "_build/$capture-export.log" 2>&1
  diff -u ports/equality-core.bits _build/equality-core-for-seal.bits
  diff -u ports/equality-core.bits.sexp _build/equality-core-for-seal.bits.sexp
  diff -u shen/equality-core.shen _build/equality-core-for-seal.bits.source
 else
 scripts/shen -l buri.shen -l shen/wire.shen -l shen/observe-encoder.shen -l shen/observe-constructor.shen \
  -e "(buri.observe-constructor \"$source\" \"_build/$capture.bits\")" \
  -e '(output "BURI_PROVENANCE_EXPORT_OK~%")' > "_build/$capture-export.log" 2>&1
 fi
 grep -qx 'BURI_PROVENANCE_EXPORT_OK' "_build/$capture-export.log" || { cat "_build/$capture-export.log"; exit 1; }
 diff -u "$source" "_build/$capture.bits.source"
 diff -u "ports/$capture.bits" "_build/$capture.bits"
 diff -u "ports/$capture.bits.sexp" "_build/$capture.bits.sexp"
 python3 scripts/package-provenance.py "$profile" "_build/$capture.bits" "_build/$module.v"
 python3 scripts/check-provenance-package.py "$profile" "_build/$capture.bits" "_build/$module.v"
 diff -u "rocq/$module.v" "_build/$module.v"
done
python3 scripts/package-provenance.py checked_io _build/observer.bits _build/CheckedIOInput.v
python3 scripts/check-provenance-package.py checked_io _build/observer.bits _build/CheckedIOInput.v
diff -u rocq/CheckedIOInput.v _build/CheckedIOInput.v
python3 scripts/package-provenance.py observer_forms _build/observer.bits _build/ObserverFormsInput.v
python3 scripts/check-provenance-package.py observer_forms _build/observer.bits _build/ObserverFormsInput.v
diff -u rocq/ObserverFormsInput.v _build/ObserverFormsInput.v
python3 scripts/package-implementation.py stock_division ports/stock-division.scm _build/StockDivisionInput.v
python3 scripts/check-implementation-package.py stock_division ports/stock-division.scm _build/StockDivisionInput.v
diff -u rocq/StockDivisionInput.v _build/StockDivisionInput.v
for module in Arithmetic Equality Lambda EquationBridge NativeArithmetic NativeOutput Wire Resolve Normalize NativeValidation NativeCapture WireTests Encoder EncoderSource EncoderTests EncoderNames EncoderFrontend EncoderKLambda EncoderFrontendTests CaptureTag ByteDomain EncoderScheme ObservedEncoder ObservedCapture ObservedTests BindingVersions Sealed Native NativeRuntime NativeSimulation NativeHelpers NativeTests SealedInput ConstructorInput NativeApplications NativeComposition NativeCodec AdapterInput AdapterCorrect SourceReader CodecCorrespondence BootstrapInput BootstrapCorrect ObserverInput ObserverEffects ObserverIO CompilerPassInput CompilerPassCorrect CompilerBindings CheckedIOInput CheckedFileIO StockDivisionInput StockDivision OrderCallInput OrderCallCorrect ObserverFormsInput ObserverPipeline IOReadInput IOReadCorrect EffectContract CallRefinement PureEffectBridge NativeReverse StockDivisionGeneral ObserverTotal FreshSupply EqualityCoreInput EqualityCoreCorrect EqualityAdmission EqualitySealInput EqualitySealCorrect StageTests SchemePortMerge CLPortGuard CLPortCapture Observation KLSyntax KLValue KLSemantics KLMetatheory KLWellFormed KLTail KLBridge KLExamples CLLowering CLLoweringCapture CLLoweringSamples KernelListInput DecodeFacts EffectBigStep OrderCallPass OrderCallPreserve EqualityInductionBaseInput EqualityInductionEquationsInput EqualityInductionTheoryInput EqualityInductionKernelInput EqualityInductionOracle EqualityInductionModel EqualityInductionSpecs EqualityInductionHelpers EqualityInductionKernel EqualityInductionSamples EqualityInductionDrivers EqualityInductionRefinement Audit; do
  cp "rocq/$module.v" "_build/rocq/$module.v"
  rm -f "_build/rocq/$module.vo" "_build/rocq/$module.vos" "_build/rocq/$module.vok"
done
cd _build/rocq
for module in Arithmetic Equality Lambda EquationBridge NativeArithmetic NativeOutput Wire Resolve Normalize NativeValidation NativeCapture WireTests Encoder EncoderSource EncoderTests EncoderNames EncoderFrontend EncoderKLambda EncoderFrontendTests CaptureTag ByteDomain EncoderScheme ObservedEncoder ObservedCapture ObservedTests BindingVersions Sealed Native NativeRuntime NativeSimulation NativeHelpers NativeTests SealedInput ConstructorInput NativeApplications NativeComposition NativeCodec AdapterInput AdapterCorrect SourceReader CodecCorrespondence BootstrapInput BootstrapCorrect ObserverInput ObserverEffects ObserverIO CompilerPassInput CompilerPassCorrect CompilerBindings CheckedIOInput CheckedFileIO StockDivisionInput StockDivision OrderCallInput OrderCallCorrect ObserverFormsInput ObserverPipeline IOReadInput IOReadCorrect EffectContract CallRefinement PureEffectBridge NativeReverse StockDivisionGeneral ObserverTotal FreshSupply EqualityCoreInput EqualityCoreCorrect EqualityAdmission EqualitySealInput EqualitySealCorrect StageTests SchemePortMerge CLPortGuard CLPortCapture Observation KLSyntax KLValue KLSemantics KLMetatheory KLWellFormed KLTail KLBridge KLExamples CLLowering CLLoweringCapture CLLoweringSamples KernelListInput DecodeFacts EffectBigStep OrderCallPass OrderCallPreserve EqualityInductionBaseInput EqualityInductionEquationsInput EqualityInductionTheoryInput EqualityInductionKernelInput EqualityInductionOracle EqualityInductionModel EqualityInductionSpecs EqualityInductionHelpers EqualityInductionKernel EqualityInductionSamples EqualityInductionDrivers EqualityInductionRefinement Audit; do
  if ! "$root/scripts/rocq" coqc -Q . Buri "$module.v" > "$module.log" 2>&1; then
    cat "$module.log"; exit 1
  fi
done
if grep -q '^Axioms:' Audit.log; then cat Audit.log; exit 1; fi
[ "$(grep -c '^Closed under the global context$' Audit.log)" = 517 ] || {
  cat Audit.log; echo 'Unexpected theorem assumption inventory' >&2; exit 1;
}
"$root/scripts/rocq" coqchk -silent -Q . Buri Buri.Arithmetic Buri.Equality Buri.Lambda Buri.EquationBridge Buri.NativeArithmetic Buri.NativeOutput Buri.Wire Buri.Resolve Buri.Normalize Buri.NativeValidation Buri.NativeCapture Buri.WireTests Buri.Encoder Buri.EncoderSource Buri.EncoderTests Buri.EncoderNames Buri.EncoderFrontend Buri.EncoderKLambda Buri.EncoderFrontendTests Buri.CaptureTag Buri.ByteDomain Buri.EncoderScheme Buri.ObservedEncoder Buri.ObservedCapture Buri.ObservedTests Buri.BindingVersions Buri.Sealed Buri.Native Buri.NativeRuntime Buri.NativeSimulation Buri.NativeHelpers Buri.NativeTests Buri.SealedInput Buri.ConstructorInput Buri.NativeApplications Buri.NativeComposition Buri.NativeCodec Buri.AdapterInput Buri.AdapterCorrect Buri.SourceReader Buri.CodecCorrespondence Buri.BootstrapInput Buri.BootstrapCorrect Buri.ObserverInput Buri.ObserverEffects Buri.ObserverIO Buri.CompilerPassInput Buri.CompilerPassCorrect Buri.CompilerBindings Buri.CheckedIOInput Buri.CheckedFileIO Buri.StockDivisionInput Buri.StockDivision Buri.OrderCallInput Buri.OrderCallCorrect Buri.ObserverFormsInput Buri.ObserverPipeline Buri.IOReadInput Buri.IOReadCorrect Buri.EffectContract Buri.CallRefinement Buri.PureEffectBridge Buri.NativeReverse Buri.StockDivisionGeneral Buri.ObserverTotal Buri.FreshSupply Buri.EqualityCoreInput Buri.EqualityCoreCorrect Buri.EqualityAdmission Buri.EqualitySealInput Buri.EqualitySealCorrect Buri.StageTests Buri.SchemePortMerge Buri.CLPortGuard Buri.CLPortCapture Buri.Observation Buri.KLSyntax Buri.KLValue Buri.KLSemantics Buri.KLMetatheory Buri.KLWellFormed Buri.KLTail Buri.KLBridge Buri.KLExamples Buri.CLLowering Buri.CLLoweringCapture Buri.CLLoweringSamples Buri.KernelListInput Buri.DecodeFacts Buri.EffectBigStep Buri.OrderCallPass Buri.OrderCallPreserve Buri.EqualityInductionBaseInput Buri.EqualityInductionEquationsInput Buri.EqualityInductionTheoryInput Buri.EqualityInductionKernelInput Buri.EqualityInductionOracle Buri.EqualityInductionModel Buri.EqualityInductionSpecs Buri.EqualityInductionHelpers Buri.EqualityInductionKernel Buri.EqualityInductionSamples Buri.EqualityInductionDrivers Buri.EqualityInductionRefinement Buri.Audit
printf 'BURI_ROCQ_OK 517 audited theorems; 18 equation bridges; 12 native compiler schemas; raw capture validated; coqchk replay passed\n'
