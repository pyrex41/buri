#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
root=$(pwd)
mkdir -p _build/rocq
rm -f _build/EquationBridge.v _build/NativeOutput.v _build/compiler-output.sexp \
 _build/native-capture.bits _build/native-capture.sexp _build/NativeCapture.v _build/EncoderSource.v \
 _build/encoder-kl.bits _build/encoder-kl.sexp _build/EncoderKLambda.v \
 _build/observed-encoder.bits.source _build/observed-encoder.bits _build/observed-encoder.sexp _build/ObservedCapture.v _build/sealed.bits _build/sealed.bits.sexp _build/SealedInput.v _build/constructor.bits _build/constructor.bits.source _build/constructor.bits.sexp _build/ConstructorInput.v
scripts/rocq coqc --version > _build/rocq-version.log
grep -q 'version 8.18.0' _build/rocq-version.log || { cat _build/rocq-version.log; exit 1; }
# Require a fresh image and regenerate the bridge from actual loaded equations.
scripts/shen -l buri.shen -l proofs/compiler.shen -l shen/export-rocq.shen \
 -e '(buri.export-rocq "_build/EquationBridge.v")' -e '(output "BURI_EXPORT_OK~%")' > _build/export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/export.log || { cat _build/export.log; exit 1; }
diff -u rocq/EquationBridge.v _build/EquationBridge.v
scripts/shen -l buri.shen -l ports/compiler-schemas.shen -l shen/export-native.shen \
 -e '(buri.export-native "_build/NativeOutput.v" "_build/compiler-output.sexp")' -e '(output "BURI_EXPORT_OK~%")' > _build/native-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/native-export.log || { cat _build/native-export.log; exit 1; }
diff -u rocq/NativeOutput.v _build/NativeOutput.v
diff -u ports/compiler-output.sexp _build/compiler-output.sexp
scripts/shen -l buri.shen -l ports/compiler-schemas.shen -l shen/export-wire.shen \
 -e '(buri.capture-wire "_build/native-capture.bits" "_build/native-capture.sexp")' -e '(output "BURI_EXPORT_OK~%")' > _build/wire-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/wire-export.log || { cat _build/wire-export.log; exit 1; }
diff -u ports/native-capture.bits _build/native-capture.bits
diff -u ports/native-capture.sexp _build/native-capture.sexp
python3 scripts/package-wire.py _build/native-capture.bits _build/NativeCapture.v
python3 scripts/check-wire-package.py _build/native-capture.bits _build/NativeCapture.v
diff -u rocq/NativeCapture.v _build/NativeCapture.v
python3 scripts/package-encoder.py shen/wire.shen _build/EncoderSource.v
python3 scripts/check-encoder-package.py shen/wire.shen _build/EncoderSource.v
diff -u rocq/EncoderSource.v _build/EncoderSource.v
scripts/shen -l buri.shen -l shen/wire.shen -l shen/export-encoder-kl.shen \
 -e '(buri.capture-encoder-kl "_build/encoder-kl.bits" "_build/encoder-kl.sexp")' -e '(output "BURI_EXPORT_OK~%")' > _build/encoder-kl-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/encoder-kl-export.log || { cat _build/encoder-kl-export.log; exit 1; }
diff -u ports/encoder-kl.bits _build/encoder-kl.bits
diff -u ports/encoder-kl.sexp _build/encoder-kl.sexp
python3 scripts/package-frontend.py _build/encoder-kl.bits _build/EncoderKLambda.v
python3 scripts/check-frontend-package.py _build/encoder-kl.bits _build/EncoderKLambda.v
diff -u rocq/EncoderKLambda.v _build/EncoderKLambda.v
scripts/shen -l buri.shen -l shen/export-encoder-kl.shen -l shen/observe-encoder.shen \
 -e '(buri.observe-encoder "shen/wire.shen" "_build/observed-encoder.bits" "_build/observed-encoder.sexp")' \
 -l shen/sealed-encoder.shen -e '(buri.export-sealed (reverse (value buri.observed)) "_build/sealed.bits")' \
 -e '(output "BURI_EXPORT_OK~%")' > _build/observed-export.log 2>&1
grep -qx 'BURI_EXPORT_OK' _build/observed-export.log || { cat _build/observed-export.log; exit 1; }
diff -u shen/wire.shen _build/observed-encoder.bits.source
diff -u ports/observed-encoder.bits _build/observed-encoder.bits
diff -u ports/observed-encoder.sexp _build/observed-encoder.sexp
python3 scripts/package-observed.py _build/observed-encoder.bits _build/ObservedCapture.v
python3 scripts/check-observed-package.py _build/observed-encoder.bits _build/ObservedCapture.v
diff -u rocq/ObservedCapture.v _build/ObservedCapture.v
diff -u ports/sealed.bits _build/sealed.bits
diff -u ports/sealed.bits.sexp _build/sealed.bits.sexp
python3 scripts/package-sealed.py _build/sealed.bits _build/SealedInput.v
python3 scripts/check-sealed-package.py _build/sealed.bits _build/SealedInput.v
diff -u rocq/SealedInput.v _build/SealedInput.v
scripts/shen -l buri.shen -l shen/wire.shen -l shen/observe-encoder.shen -l shen/observe-constructor.shen \
 -e '(buri.observe-constructor "shen/sealed-encoder.shen" "_build/constructor.bits")' \
 -e '(output "BURI_CONSTRUCTOR_EXPORT_OK~%")' > _build/constructor-export.log 2>&1
grep -qx 'BURI_CONSTRUCTOR_EXPORT_OK' _build/constructor-export.log || { cat _build/constructor-export.log; exit 1; }
diff -u shen/sealed-encoder.shen _build/constructor.bits.source
diff -u ports/constructor.bits _build/constructor.bits
diff -u ports/constructor.bits.sexp _build/constructor.bits.sexp
python3 scripts/package-constructor.py _build/constructor.bits _build/ConstructorInput.v
python3 scripts/check-constructor-package.py _build/constructor.bits _build/ConstructorInput.v
diff -u rocq/ConstructorInput.v _build/ConstructorInput.v
for module in Arithmetic Equality Lambda EquationBridge NativeArithmetic NativeOutput Wire Resolve Normalize NativeValidation NativeCapture WireTests Encoder EncoderSource EncoderTests EncoderNames EncoderFrontend EncoderKLambda EncoderFrontendTests CaptureTag ByteDomain EncoderScheme ObservedEncoder ObservedCapture ObservedTests BindingVersions Sealed Native NativeRuntime NativeHelpers NativeTests SealedInput ConstructorInput Audit; do
  cp "rocq/$module.v" "_build/rocq/$module.v"
  rm -f "_build/rocq/$module.vo" "_build/rocq/$module.vos" "_build/rocq/$module.vok"
done
cd _build/rocq
for module in Arithmetic Equality Lambda EquationBridge NativeArithmetic NativeOutput Wire Resolve Normalize NativeValidation NativeCapture WireTests Encoder EncoderSource EncoderTests EncoderNames EncoderFrontend EncoderKLambda EncoderFrontendTests CaptureTag ByteDomain EncoderScheme ObservedEncoder ObservedCapture ObservedTests BindingVersions Sealed Native NativeRuntime NativeHelpers NativeTests SealedInput ConstructorInput Audit; do
  if ! "$root/scripts/rocq" coqc -Q . Buri "$module.v" > "$module.log" 2>&1; then
    cat "$module.log"; exit 1
  fi
done
if grep -q '^Axioms:' Audit.log; then cat Audit.log; exit 1; fi
[ "$(grep -c '^Closed under the global context$' Audit.log)" = 166 ] || {
  cat Audit.log; echo 'Unexpected theorem assumption inventory' >&2; exit 1;
}
"$root/scripts/rocq" coqchk -silent -Q . Buri Buri.Arithmetic Buri.Equality Buri.Lambda Buri.EquationBridge Buri.NativeArithmetic Buri.NativeOutput Buri.Wire Buri.Resolve Buri.Normalize Buri.NativeValidation Buri.NativeCapture Buri.WireTests Buri.Encoder Buri.EncoderSource Buri.EncoderTests Buri.EncoderNames Buri.EncoderFrontend Buri.EncoderKLambda Buri.EncoderFrontendTests Buri.CaptureTag Buri.ByteDomain Buri.EncoderScheme Buri.ObservedEncoder Buri.ObservedCapture Buri.ObservedTests Buri.BindingVersions Buri.Sealed Buri.Native Buri.NativeRuntime Buri.NativeHelpers Buri.NativeTests Buri.SealedInput Buri.ConstructorInput Buri.Audit
printf 'BURI_ROCQ_OK 166 audited theorems; 18 equation bridges; 12 native compiler schemas; raw capture validated; coqchk replay passed\n'
