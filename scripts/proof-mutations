#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
root=$(pwd)
mkdir -p _build/mutations
python3 - <<'PY'
from pathlib import Path
source = Path('rocq/Arithmetic.v').read_text()
mutations = {
 'WrongInstruction': ('compile b (Times k)', 'compile b (Plus k)'),
 'DroppedPush': ("run k' (n :: s)", "run k' s"),
}
for name, (old, new) in mutations.items():
 assert source.count(old) == 1, name
 Path('_build/mutations', name + '.v').write_text(source.replace(old, new))
bridge = Path('rocq/EquationBridge.v').read_text()
old = '(compile v_a (compile v_b (Plus v_k)))'
assert bridge.count(old) == 1
Path('_build/mutations/FalseEquation.v').write_text(bridge.replace(old, '(compile v_a (compile v_b (Times v_k)))'))
encoder = Path('rocq/Encoder.v').read_text()
for name, old, new in [
 ('WrongEncoderTag', '(Op Cat (text "011")', '(Op Cat (text "010")'),
 ('WrongEncoderBit', '(text "0") (text "1"))', '(text "1") (text "0"))'),
]:
 assert encoder.count(old) == 1, name
 Path('_build/mutations', name + '.v').write_text(encoder.replace(old, new))
source = Path('rocq/EncoderSource.v').read_text()
old = '(cn ""011""'
assert source.count(old) == 1
Path('_build/mutations/FalseEncoderSource.v').write_text(source.replace(old, '(cn ""010""'))
native = Path('rocq/NativeOutput.v').read_text()
old = 'seval rho (SAdd (SVar 0) (SVar 1))'
assert native.count(old) == 1
Path('_build/mutations/FalseNativeOutput.v').write_text(native.replace(old, 'seval rho (SMul (SVar 0) (SVar 1))'))
PY
python3 tests/mutate-observed.py
python3 tests/mutate-sealed.py
python3 tests/mutate-constructor.py
python3 tests/mutate-adapter.py
python3 tests/mutate-provenance.py
python3 tests/mutate-checkedio.py
for name in CorruptCapture TruncatedCapture TrailingCapture OmittedCaptureRecord WrongCaptureProfile; do
  python3 scripts/package-wire.py "_build/mutations/$name.bits" "_build/mutations/$name.v"
done
for name in KLChangedDivisor KLChangedTag KLWrongBinder KLDuplicateParameters KLOmittedDefinition KLWrongCallee; do
  python3 scripts/package-frontend.py "_build/mutations/$name.bits" "_build/mutations/$name.v"
done
for name in ObservedWrongTag ObservedWrongDivisor ObservedWrongCallee ObservedParallelLet ObservedChangedSource ObservedUnboundTemporary ObservedReorderedPairs ObservedOmittedPair; do
  python3 scripts/package-observed.py "_build/mutations/$name.bits" "_build/mutations/$name.v"
done
for name in SealedUnknown SealedEval SealedMutation SealedDifferentTarget SealedDifferentHelper SealedMissingHelper SealedExtraImport; do
  python3 scripts/package-sealed.py "_build/mutations/$name.bits" "_build/mutations/$name.v"
done
for name in CtorLambda CtorAuthority CtorBoolean CtorExecutor CtorEntry CtorAppendOrder CtorOmitted CtorExtra; do
  python3 scripts/package-constructor.py "_build/mutations/$name.bits" "_build/mutations/$name.v"
done
for name in WrongInstruction DroppedPush FalseEquation FalseNativeOutput CorruptCapture TruncatedCapture TrailingCapture OmittedCaptureRecord WrongCaptureProfile WrongEncoderTag WrongEncoderBit FalseEncoderSource KLChangedDivisor KLChangedTag KLWrongBinder KLDuplicateParameters KLOmittedDefinition KLWrongCallee ObservedWrongTag ObservedWrongDivisor ObservedWrongCallee ObservedParallelLet ObservedChangedSource ObservedUnboundTemporary ObservedReorderedPairs ObservedOmittedPair SealedUnknown SealedEval SealedMutation SealedDifferentTarget SealedDifferentHelper SealedMissingHelper SealedExtraImport CtorLambda CtorAuthority CtorBoolean CtorExecutor CtorEntry CtorAppendOrder CtorOmitted CtorExtra AdapterWrongTag AdapterWrongTail AdapterWrongChild AdapterWrongType BootstrapBooleanTag BootstrapWrongChild ObserverWrongActivation ObserverWrongPublication CompilerPassWrongKeyword UncheckedSuccess UncheckedRead; do
  if scripts/rocq coqc -Q _build/rocq Buri "_build/mutations/$name.v" > "_build/mutations/$name.log" 2>&1; then
    echo "Mutant incorrectly accepted: $name" >&2; exit 1
  fi
  grep -Eq 'Unable to unify|Not convertible' "_build/mutations/$name.log" || { cat "_build/mutations/$name.log"; exit 1; }
  printf 'Rejected proof mutation: %s\n' "$name"
done
